<Window x:Class="TidyMind.EntityTypeSelector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TidyMind"
        mc:Ignorable="d"
        Title="Add Entity" Height="220" Width="300"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#252526" Padding="20,14">
            <TextBlock Text="What do you want to add?"
                       FontSize="16" FontWeight="Bold"
                       Foreground="#569CD6"/>
        </Border>

        <WrapPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="👕 Clothing" Width="160" Height="70" Margin="8" FontSize="13" Tag="Clothing" Click="TypeButton_Click"/>
        </WrapPanel>
    </Grid>
</Window>
