<Window x:Class="TidyMind.EntityTypeSelector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TidyMind"
        mc:Ignorable="d"
        Title="Add Entity" Height="420" Width="500"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#252526" Padding="20,14">
            <TextBlock Text="What do you want to add?"
                       FontSize="16" FontWeight="Bold"
                       Foreground="#569CD6"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#1E1E1E">
            <WrapPanel HorizontalAlignment="Center" Margin="20,20,20,20">
                <Button Content="👕 Clothing"   Width="130" Height="70" Margin="8" FontSize="13" Tag="Clothing"    Click="TypeButton_Click"/>
                <Button Content="🚗 Car"         Width="130" Height="70" Margin="8" FontSize="13" Tag="Car"         Click="TypeButton_Click"/>
                <Button Content="🏍️ Motorcycle"  Width="130" Height="70" Margin="8" FontSize="13" Tag="Motorcycle"  Click="TypeButton_Click"/>
                <Button Content="📚 Book"        Width="130" Height="70" Margin="8" FontSize="13" Tag="Book"        Click="TypeButton_Click"/>
                <Button Content="🎮 Game"        Width="130" Height="70" Margin="8" FontSize="13" Tag="Game"        Click="TypeButton_Click"/>
                <Button Content="🎬 Movie"       Width="130" Height="70" Margin="8" FontSize="13" Tag="Movie"       Click="TypeButton_Click"/>
                <Button Content="💻 Electronics" Width="130" Height="70" Margin="8" FontSize="13" Tag="Electronics" Click="TypeButton_Click"/>
                <Button Content="🐾 Pet"         Width="130" Height="70" Margin="8" FontSize="13" Tag="Pet"         Click="TypeButton_Click"/>
                <Button Content="🌱 Plant"       Width="130" Height="70" Margin="8" FontSize="13" Tag="Plant"       Click="TypeButton_Click"/>
                <Button Content="🏠 Property"    Width="130" Height="70" Margin="8" FontSize="13" Tag="Property"    Click="TypeButton_Click"/>
                <Button Content="💊 Medicine"    Width="130" Height="70" Margin="8" FontSize="13" Tag="Medicine"    Click="TypeButton_Click"/>
                <Button Content="🎨 Artwork"     Width="130" Height="70" Margin="8" FontSize="13" Tag="Artwork"     Click="TypeButton_Click"/>
                <Button Content="⚙️ Custom"      Width="130" Height="70" Margin="8" FontSize="13" Tag="Custom"      Click="TypeButton_Click"/>
            </WrapPanel>
        </ScrollViewer>
    </Grid>
</Window>