<Window x:Class="TidyMind.EntityTypeSelector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TidyMind"
        mc:Ignorable="d"
        Title="{local:Tr Entity.Add.Item}" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BgMain}">
    <StackPanel>
        <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="20,16">
            <TextBlock Text="{local:Tr Entity.WhatToAdd}"
                       FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource TextMain}"/>
        </Border>

        <!-- One choice per type: its icon, name and what it is for. Custom is there too (CollectionView creates its layout). -->
        <StackPanel Margin="20,16,20,0">
            <Button Style="{StaticResource GhostButtonStyle}" Height="Auto" Padding="14,10" Margin="0,0,0,8"
                    HorizontalContentAlignment="Stretch" Tag="Clothing" Click="TypeButton_Click">
                <Grid Width="330">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="👕" FontSize="22" Margin="0,0,0,0"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{local:Tr Entity.Type.Clothing}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                        <TextBlock Text="{local:Tr Entity.Type.Clothing.Text}" FontSize="12" Foreground="{StaticResource TextSub}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Button>
            <Button Style="{StaticResource GhostButtonStyle}" Height="Auto" Padding="14,10" Margin="0,0,0,8"
                    HorizontalContentAlignment="Stretch" Tag="Vehicle" Click="TypeButton_Click">
                <Grid Width="330">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🚗" FontSize="22" Margin="0,0,0,0"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{local:Tr Entity.Type.Vehicle}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                        <TextBlock Text="{local:Tr Entity.Type.Vehicle.Text}" FontSize="12" Foreground="{StaticResource TextSub}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Button>
            <Button x:Name="CustomButton" Style="{StaticResource GhostButtonStyle}" Height="Auto" Padding="14,10"
                    HorizontalContentAlignment="Stretch" Click="TypeButton_Click">
                <Grid Width="330">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🧩" FontSize="22" Margin="0,0,0,0"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{local:Tr Entity.Type.Custom}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                        <TextBlock x:Name="CustomText" Text="{local:Tr Entity.Type.Custom.Text}" FontSize="12"
                                   Foreground="{StaticResource TextSub}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Button>
        </StackPanel>

        <TextBlock Text="{local:Tr Entity.Picker.Soon}" FontSize="12" FontStyle="Italic" Foreground="{StaticResource TextSub}"
                   HorizontalAlignment="Center" Margin="20,14,20,18"/>
    </StackPanel>
</Window>
