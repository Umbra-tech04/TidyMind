<Window x:Class="TidyMind.EntityTypeSelector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TidyMind"
        mc:Ignorable="d"
        Title="{local:Tr Entity.Add.Item}" Height="200" Width="380"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMain}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="20,16">
            <TextBlock Text="{local:Tr Entity.WhatToAdd}"
                       FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource TextMain}"/>
        </Border>

        <WrapPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="{local:Tr Entity.Type.Clothing}" Style="{StaticResource GhostButtonStyle}" Width="150" Height="56" Margin="8"
                    FontSize="13" Tag="Clothing" Click="TypeButton_Click"/>
            <Button Content="{local:Tr Entity.Type.Vehicle}" Style="{StaticResource GhostButtonStyle}" Width="150" Height="56" Margin="8"
                    FontSize="13" Tag="Vehicle" Click="TypeButton_Click"/>
        </WrapPanel>
    </Grid>
</Window>
