<Window x:Class="TidyMind.ItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TidyMind"
        MinWidth="560" MinHeight="480" ResizeMode="CanResize" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgMain}">
    <!-- One scrolling page: the pictures, the title block, then the sections (a list of them on the left when the type
         has several, above the content when the window is narrow), in a column of a readable width -->
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" FocusVisualStyle="{x:Null}">
        <StackPanel>
            <!-- PictureHero, made in code; collapsed while the item has no picture -->
            <ContentControl x:Name="Hero" Focusable="False"/>

            <Grid x:Name="Column" MaxWidth="1120" Margin="24,0,24,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- The title block: what it is, its name, what it is made of, its key facts as chips; the actions on the
                     right, or under it when the window is narrow (Layout) -->
                <Grid Margin="0,24,0,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="EyebrowText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                        <TextBox x:Name="NameText" Style="{StaticResource SelectableTextStyle}" FontFamily="{StaticResource DisplayFont}"
                                 FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="SubtitleText" FontSize="15" Foreground="{StaticResource TextBody}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <WrapPanel x:Name="Chips" Margin="0,16,0,0"/>
                    </StackPanel>
                    <WrapPanel x:Name="Actions" Grid.Column="1" Margin="24,4,0,0" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                </Grid>

                <!-- The sections: the list (Settings' look) beside the content; narrow, a dropdown above it (Layout) -->
                <Grid x:Name="Body" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="NavColumn" Width="208"/>
                        <ColumnDefinition x:Name="GapColumn" Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="Nav">
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}" Margin="0,0,0,12"
                                 Tag="{local:Tr Vehicle.Search.Placeholder}" AutomationProperties.Name="{local:Tr Vehicle.Search.Placeholder}"
                                 TextChanged="SearchBox_TextChanged"/>
                        <!-- Narrow: the pages as a dropdown (a list that wraps would leave one alone on a line) -->
                        <ComboBox x:Name="SectionPicker" Height="36" Margin="0,0,0,4" Visibility="Collapsed"
                                  AutomationProperties.Name="{local:Tr Item.Pages}"
                                  SelectionChanged="SectionPicker_SelectionChanged"/>
                        <ListBox x:Name="SectionList" Background="Transparent" BorderThickness="0" Padding="0"
                                 ItemContainerStyle="{StaticResource CategoryStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="SectionList_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel x:Name="Page" Grid.Column="2"/>
                </Grid>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
