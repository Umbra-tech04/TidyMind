<Window x:Class="TidyMind.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TidyMind"
        mc:Ignorable="d"
        Title="ProfileWindow" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="TidyMind" FontSize="32" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,20,0,5"/>

        <TextBlock Grid.Row="1" Text="Choose your memory" FontSize="16"
                   HorizontalAlignment="Center" Foreground="Gray"
                   Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="20,0,20,10">
            <WrapPanel x:Name="ProfilePanel" HorizontalAlignment="Center"/>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Button x:Name="AddProfileButton" Content="+ Add memory"
                    Width="150" Height="35" Margin="0,0,15,0"
                    Click="AddProfileButton_Click"/>
            <TextBlock Text="Right-click a memory to edit"
                       FontSize="11" Foreground="DarkGray"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>