<Window x:Class="TidyMind.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TidyMind"
        mc:Ignorable="d"
        Title="TidyMind" Height="700" Width="1050"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="TidyMind" FontSize="32" FontWeight="Bold"
                   Foreground="#569CD6"
                   HorizontalAlignment="Center" Margin="0,24,0,6"/>

        <Button x:Name="RemindersButton" Grid.Row="0" Content="🔔 Reminders"
                Width="120" Height="30"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,24,20,0"
                Click="RemindersButton_Click"/>

        <TextBlock Grid.Row="1" Text="Choose your memory" FontSize="14"
                   HorizontalAlignment="Center" Foreground="#858585"
                   Margin="0,0,0,20"/>

        <TextBox x:Name="SearchBox" Grid.Row="2"
                 Width="400" Height="32"
                 HorizontalAlignment="Center"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,16"
                 Background="#3C3C3C" Foreground="#858585"
                 BorderBrush="#474747"
                 Text="Search..."
                 GotFocus="SearchBox_GotFocus"
                 LostFocus="SearchBox_LostFocus"
                 TextChanged="SearchBox_TextChanged"/>

        <!-- Két oszlop -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Bal: Projects -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Projects"
                           FontSize="13" Foreground="#858585"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Background="#1E1E1E">
                    <WrapPanel x:Name="ProjectPanel" HorizontalAlignment="Center"/>
                </ScrollViewer>

                <Button Grid.Row="2" x:Name="AddProjectButton" Content="+ Add Project Memory"
                        Width="180" Height="34" Margin="0,10,0,10"
                        HorizontalAlignment="Center"
                        Click="AddProjectButton_Click"/>
            </Grid>

            <!-- Elválasztó vonal -->
            <Rectangle Grid.Column="1" Width="1" Fill="#3C3C3C" Margin="10,0"/>

            <!-- Jobb: Collections -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Collections"
                           FontSize="13" Foreground="#858585"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Background="#1E1E1E">
                    <WrapPanel x:Name="CollectionPanel" HorizontalAlignment="Center"/>
                </ScrollViewer>

                <Button Grid.Row="2" x:Name="AddCollectionButton" Content="+ Add Collection"
                        Width="180" Height="34" Margin="0,10,0,10"
                        HorizontalAlignment="Center"
                        Click="AddCollectionButton_Click"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,16">
            <TextBlock Text="Right-click a memory to edit"
                       FontSize="11" Foreground="#858585"
                       HorizontalAlignment="Center"/>
        </Grid>

        <Button x:Name="QuickNotesButton" Grid.RowSpan="5"
                Style="{StaticResource IconButtonStyle}"
                Content="📝" ToolTip="Quick Notes (Ctrl+Shift+N)"
                Width="36" Height="36" FontSize="16" Padding="0,0,6,0"
                Background="#3C3C3C"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,16,60" Panel.ZIndex="100"
                Click="QuickNotesButton_Click"/>

        <Button x:Name="ExportAllButton"
                Grid.RowSpan="5"
                Style="{StaticResource IconButtonStyle}"
                Content="📤" ToolTip="Export All"
                Width="36" Height="36" FontSize="16" Padding="0,0,6,0"
                Background="#2ECC71"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,16,16" Panel.ZIndex="100"
                Click="ExportAllButton_Click"/>

        <Button x:Name="HelpButton" Grid.RowSpan="5"
                Style="{StaticResource IconButtonStyle}"
                Content="?" ToolTip="Keyboard Shortcuts" FontWeight="Bold"
                Width="36" Height="36" FontSize="16"
                Background="#3C3C3C"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="16,0,0,16" Panel.ZIndex="100"
                Click="HelpButton_Click"/>

        <Popup x:Name="HelpPopup" PlacementTarget="{Binding ElementName=HelpButton}"
               Placement="Top" StaysOpen="False" AllowsTransparency="True">
            <Border Background="#252526" BorderBrush="#474747" BorderThickness="1" Padding="14">
                <StackPanel>
                    <TextBlock Text="Keyboard Shortcuts" FontWeight="Bold" FontSize="13"
                               Foreground="#569CD6" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl+Shift+N" FontFamily="Consolas"
                                   FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="— Quick Notes"
                                   Foreground="#CCCCCC" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+Shift+R" FontFamily="Consolas"
                                   FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="— Reminders"
                                   Foreground="#CCCCCC"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>