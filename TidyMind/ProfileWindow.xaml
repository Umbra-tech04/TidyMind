<Window x:Class="TidyMind.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TidyMind"
        mc:Ignorable="d"
        Title="ProfileWindow" Height="450" Width="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="TidyMind" FontSize="32" FontWeight="Bold"
               HorizontalAlignment="Center" Margin="0,0,0,5"/>

            <TextBlock Text="Choose your profile" FontSize="16"
               HorizontalAlignment="Center" Foreground="Gray"
               Margin="0,0,0,30"/>

            <WrapPanel x:Name="ProfilePanel" HorizontalAlignment="Center"
               Margin="0,0,0,20"/>

            <Button x:Name="AddProfileButton" Content="+ Add Profile"
            Width="150" Height="35" HorizontalAlignment="Center"
            Click="AddProfileButton_Click"/>

        </StackPanel>

    </Grid>
</Window>
