<Window x:Class="TidyMind.DayEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Day" Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgMain}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="NoteInputStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background"  Value="#FAFAF9"/>
            <Setter Property="BorderBrush" Value="#D5D5D2"/>
            <Setter Property="FontSize"    Value="14"/>
            <Setter Property="Padding"     Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="10,8" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#BDBDB9"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,22,24,20">
        <TextBlock x:Name="HeadingText" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
        <TextBlock x:Name="SubheadingText" FontSize="12" Foreground="{StaticResource TextSub}" Margin="0,4,0,0"/>

        <TextBlock Text="COLOR" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSub}" Margin="0,20,0,8"/>
        <WrapPanel x:Name="SwatchPanel"/>

        <!-- The day's note: a title and what to do. Saved to calendar.json only; it never becomes a reminder.
             (Reminders are added separately, from the day's right-click menu in the calendar.) -->
        <TextBlock Text="TITLE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSub}" Margin="0,18,0,8"/>
        <Grid>
            <TextBox x:Name="TitleInput" Style="{StaticResource NoteInputStyle}" FontSize="14" FontWeight="SemiBold"
                     KeyDown="TitleInput_KeyDown" TextChanged="TitleInput_TextChanged"/>
            <TextBlock x:Name="TitlePlaceholder" Text="e.g. Car service" FontSize="14"
                       Foreground="{StaticResource TextSub}" Margin="13,0,0,0" VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>

        <TextBlock Text="NOTE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSub}" Margin="0,14,0,8"/>
        <Grid>
            <TextBox x:Name="NoteInput" Style="{StaticResource NoteInputStyle}" Height="100"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     TextChanged="NoteInput_TextChanged"/>
            <TextBlock x:Name="NotePlaceholder" Text="What needs doing…" FontSize="14"
                       Foreground="{StaticResource TextSub}" Margin="13,9,0,0" VerticalAlignment="Top"
                       IsHitTestVisible="False"/>
        </Grid>

        <Grid Margin="0,22,0,0">
            <Button x:Name="ClearButton" Content="Clear day" HorizontalAlignment="Left"
                    ToolTip="Removes this day's color, title and note."
                    Style="{StaticResource GhostButtonStyle}" Foreground="{StaticResource Danger}"
                    Height="36" Padding="14,0" Visibility="Collapsed"
                    Click="ClearButton_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource GhostButtonStyle}"
                        Width="92" Height="36" Margin="0,0,10,0"/>
                <Button x:Name="SaveButton" Content="Save" ToolTip="Save  (Ctrl+Enter)"
                        Width="104" Height="36" FontWeight="SemiBold"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
