<Window x:Class="TidyMind.DayEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TidyMind"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgMain}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel Margin="24,22,24,20">
        <TextBlock x:Name="HeadingText" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
        <TextBlock x:Name="SubheadingText" FontSize="12" Foreground="{StaticResource TextSub}" Margin="0,4,0,0"/>
        <!-- The day's time blocks live in the day plan: this closes the dialog (and the calendar) and opens it -->
        <Button x:Name="OpenPlanButton" Style="{StaticResource LinkButtonStyle}" Foreground="{StaticResource BtnHover}"
                FontSize="12" HorizontalAlignment="Left" Margin="-2,8,0,0" Click="OpenPlanButton_Click"/>

        <TextBlock Text="{local:Tr Day.Color}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSub}" Margin="0,20,0,8"/>
        <WrapPanel x:Name="SwatchPanel"/>

        <!-- The day's note: a title and what to do. Saved to calendar.json only; it never becomes a reminder.
             (Reminders are added separately, from the day's right-click menu in the calendar.) -->
        <TextBlock Text="{local:Tr Day.Title}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSub}" Margin="0,18,0,8"/>
        <Grid>
            <TextBox x:Name="TitleInput" Style="{StaticResource NoteInputStyle}" FontSize="14" FontWeight="SemiBold"
                     KeyDown="TitleInput_KeyDown" TextChanged="TitleInput_TextChanged"/>
            <TextBlock x:Name="TitlePlaceholder" Text="{local:Tr Day.TitlePlaceholder}" FontSize="14"
                       Foreground="{StaticResource TextSub}" Margin="13,0,0,0" VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>

        <TextBlock Text="{local:Tr Day.Note}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSub}" Margin="0,14,0,8"/>
        <Grid>
            <TextBox x:Name="NoteInput" Style="{StaticResource NoteInputStyle}" Height="100"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     TextChanged="NoteInput_TextChanged"/>
            <TextBlock x:Name="NotePlaceholder" Text="{local:Tr Day.NotePlaceholder}" FontSize="14"
                       Foreground="{StaticResource TextSub}" Margin="13,9,0,0" VerticalAlignment="Top"
                       IsHitTestVisible="False"/>
        </Grid>

        <Grid Margin="0,22,0,0">
            <Button x:Name="ClearButton" Content="{local:Tr Day.Clear}" HorizontalAlignment="Left"
                    ToolTip="{local:Tr Day.ClearTip}"
                    Style="{StaticResource GhostButtonStyle}" Foreground="{StaticResource Danger}"
                    Height="36" Padding="14,0" Visibility="Collapsed"
                    Click="ClearButton_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{local:Tr Common.Cancel}" IsCancel="True" Style="{StaticResource GhostButtonStyle}"
                        MinWidth="92" Padding="14,0" Height="36" Margin="0,0,10,0"/>
                <Button x:Name="SaveButton" Content="{local:Tr Common.Save}" ToolTip="{local:Tr Common.SaveTip}"
                        MinWidth="104" Padding="14,0" Height="36" FontWeight="SemiBold"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
