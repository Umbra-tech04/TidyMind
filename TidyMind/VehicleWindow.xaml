<Window x:Class="TidyMind.VehicleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TidyMind"
        MinWidth="640" MinHeight="520" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgMain}">
    <!-- One scrolling page: header, tabs and the tab's cards, so a small window still reaches everything -->
    <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" FocusVisualStyle="{x:Null}">
        <StackPanel>
            <!-- Header: the pictures and the key facts side by side, stacked when the window is narrow (LayoutHeader) -->
            <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                    BorderThickness="0,0,0,1" Padding="24,20,24,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="FactsColumn" Width="1.2*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="GalleryFrame" Background="{StaticResource BgSubtle}" CornerRadius="12" Height="280" Padding="12">
                        <Grid>
                            <!-- PictureBrowser, made in code -->
                            <ContentControl x:Name="Gallery" Focusable="False"/>
                            <StackPanel x:Name="NoPictures" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="34" HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextSub}"/>
                                <TextBlock Text="{local:Tr Entity.NoPictures}" Margin="0,10,0,0" HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextSub}"/>
                                <Button Content="{local:Tr Vehicle.AddPictures}" Style="{StaticResource GhostButtonStyle}" Margin="0,12,0,0"
                                        HorizontalAlignment="Center" Click="EditBasics_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="Facts" Grid.Column="1" Margin="24,0,0,0">
                        <TextBox x:Name="NameText" Style="{StaticResource SelectableTextStyle}" FontSize="24" FontWeight="Bold"
                                 Foreground="{StaticResource TextMain}"/>
                        <TextBlock x:Name="SubtitleText" FontSize="13" Foreground="{StaticResource TextSub}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <WrapPanel Margin="0,14,0,0">
                            <Border x:Name="PlateChip" BorderBrush="{StaticResource TextMain}" BorderThickness="1.5" CornerRadius="4"
                                    Padding="8,2" Margin="0,0,14,8" VerticalAlignment="Center">
                                <TextBox x:Name="PlateText" Style="{StaticResource SelectableTextStyle}" FontSize="14" FontWeight="SemiBold"
                                         Foreground="{StaticResource TextMain}" TextWrapping="NoWrap"/>
                            </Border>
                            <TextBlock x:Name="OdometerText" FontSize="14" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"
                                       Margin="0,0,12,8"/>
                            <Button Content="{local:Tr Vehicle.Odometer.Update}" Style="{StaticResource GhostButtonStyle}" Margin="0,0,0,8"
                                    VerticalAlignment="Center" Click="UpdateOdometer_Click"/>
                        </WrapPanel>
                        <!-- The nearest deadlines, by urgency -->
                        <WrapPanel x:Name="Badges" Margin="0,6,0,0"/>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="{local:Tr Vehicle.EditBasics}" Style="{StaticResource GhostButtonStyle}" Margin="0,0,10,6"
                                    Click="EditBasics_Click"/>
                            <Button Content="{local:Tr Common.Delete}" Style="{StaticResource GhostButtonStyle}" Foreground="{StaticResource Danger}"
                                    Margin="0,0,10,6" Click="Delete_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tabs: Overview, then the type's own (EntityTypes.Tabs), wrapping when the window is narrow; the search over
                 the whole vehicle beside them (VehicleSearch) -->
            <Grid Margin="22,12,24,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel x:Name="TabsPanel" VerticalAlignment="Center"/>
                <TextBox x:Name="SearchBox" Grid.Column="1" Width="220" Margin="12,0,0,0" VerticalAlignment="Top"
                         Style="{StaticResource SearchBoxStyle}" Tag="{local:Tr Vehicle.Search.Placeholder}"
                         AutomationProperties.Name="{local:Tr Vehicle.Search.Placeholder}" TextChanged="SearchBox_TextChanged"/>
            </Grid>

            <local:CellPanel x:Name="Cards" Margin="24,10,24,24" MinColumn="380" ColumnGap="16" RowGap="16"/>
        </StackPanel>
    </ScrollViewer>
</Window>
