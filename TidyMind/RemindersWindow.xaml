<Window x:Class="TidyMind.RemindersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TidyMind"
        mc:Ignorable="d"
        Title="Reminders" Height="540" Width="460"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#252526" Padding="20,14">
            <TextBlock Text="🔔 Reminders" FontSize="20" FontWeight="Bold"
                       Foreground="#569CD6"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#1E1E1E">
            <StackPanel x:Name="RemindersPanel" Margin="20"/>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#252526" Padding="20,10">
            <Button x:Name="AddReminderButton" Content="+ Add Reminder"
                    Width="160" Height="34" HorizontalAlignment="Right"
                    Click="AddReminderButton_Click"/>
        </Border>
    </Grid>
</Window>
