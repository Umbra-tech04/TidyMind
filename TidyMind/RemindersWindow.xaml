<Window x:Class="TidyMind.RemindersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TidyMind"
        mc:Ignorable="d"
        Title="Reminders" Height="540" Width="460"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMain}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="20,16">
            <TextBlock Text="🔔 Reminders" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextMain}"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="{StaticResource BgMain}">
            <StackPanel x:Name="RemindersPanel" Margin="20"/>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="20,10">
            <Button x:Name="AddReminderButton" Content="+ Add Reminder"
                    Width="160" Height="34" HorizontalAlignment="Right"
                    Click="AddReminderButton_Click"/>
        </Border>
    </Grid>
</Window>
