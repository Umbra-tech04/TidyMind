<Window x:Class="TidyMind.NotebookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TidyMind"
        Width="640" Height="720" MinWidth="560" MinHeight="540"
        ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgMain}">
    <!-- A memory's own notebook: the same notebook as in Project Details (NotebookEditor), for the whole memory -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="32,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE736;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource TextSub}"
                           VerticalAlignment="Center" Margin="0,2,12,0"/>
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextMain}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Background="{StaticResource BgMain}">
            <StackPanel Margin="32,24,32,28">
                <TextBlock Text="{local:Tr Notebook.Intro}" FontSize="12" Foreground="{StaticResource TextSub}"
                           TextWrapping="Wrap" Margin="0,0,0,16"/>
                <local:NotebookEditor x:Name="Notebook"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Sticky footer, as in Project Details: every way of closing saves -->
        <Border Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="32,12">
            <Button x:Name="SaveButton" Content="{local:Tr Common.Save}" HorizontalAlignment="Right"
                    MinWidth="128" Padding="16,0" Height="38" FontWeight="SemiBold" Click="SaveButton_Click"/>
        </Border>
    </Grid>
</Window>
