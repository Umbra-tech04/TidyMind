<UserControl x:Class="TidyMind.CollectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:TidyMind"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <!-- Right-click on empty space opens Edit Background (MemoryPageBackground). -->
    <Grid x:Name="Page" Background="{StaticResource BgMain}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The memory's own background (Edit Background), behind everything -->
        <Grid x:Name="BackgroundLayer" Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="True"/>

        <!-- Header -->
        <Border Grid.Row="0" Padding="28,24,28,16">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource TextMain}"/>
                    <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="{StaticResource TextSub}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- While cards are selected, the selection bar replaces this row (see UpdateSelectionBar) -->
                <local:SelectionBar x:Name="SelectionBar" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Visibility="Collapsed"/>
                <StackPanel x:Name="Toolbar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}"
                             Width="240" Margin="0,0,10,0"
                             Foreground="{StaticResource TextSub}" Text="Search..."
                             GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus"
                             TextChanged="SearchBox_TextChanged"/>
                    <Button x:Name="AddEntityButton" Content="+  Add Entity" Height="36" Padding="16,0"
                            Click="AddEntityButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab strip -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      Padding="26,0,28,6">
            <StackPanel x:Name="TabStrip" Orientation="Horizontal"/>
        </ScrollViewer>

        <!-- Cards -->
        <!-- Drag on empty space to select cards (CardSelectionController) -->
        <ScrollViewer x:Name="CardScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="16,0,16,20">
            <Grid x:Name="CardArea">
                <WrapPanel x:Name="EntityPanel"/>
                <TextBlock x:Name="EmptyState" Text="No items yet. Click “+ Add Entity” to start."
                           FontSize="13" Foreground="{StaticResource TextSub}"
                           HorizontalAlignment="Center" Margin="0,60,0,0"
                           Visibility="Collapsed"/>
                <Canvas x:Name="MarqueeCanvas" IsHitTestVisible="False"/>
            </Grid>
        </ScrollViewer>

        <!-- Detail overlay -->
        <Grid x:Name="OverlayGrid" Grid.RowSpan="3"
              Background="#55000000" Visibility="Collapsed"
              MouseLeftButtonDown="OverlayGrid_MouseLeftButtonDown">
            <Border x:Name="DetailCard"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="10" MaxWidth="700" MaxHeight="440"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="DetailCard_MouseLeftButtonDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.18" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource BgSubtle}" CornerRadius="10,0,0,10">
                        <Image x:Name="DetailImage" Stretch="Uniform" Margin="16"/>
                    </Border>

                    <Grid Grid.Column="1" Margin="24,20,24,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBox x:Name="DetailName" Style="{StaticResource SelectableTextStyle}"
                                     FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextMain}"
                                     VerticalAlignment="Center" Margin="0,0,40,0"/>
                            <Button Content="✕" Width="30" Height="30"
                                    Style="{StaticResource IconButtonStyle}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Click="CloseOverlay_Click"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="DetailPanel"/>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Orientation="Horizontal"
                                    HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button x:Name="DetailEditButton" Content="Edit" Width="90" Height="34"
                                    Margin="0,0,10,0" Click="DetailEditButton_Click"/>
                            <Button x:Name="DetailDeleteButton" Content="Delete" Width="90" Height="34"
                                    Style="{StaticResource GhostButtonStyle}" Foreground="{StaticResource Danger}"
                                    Click="DetailDeleteButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
