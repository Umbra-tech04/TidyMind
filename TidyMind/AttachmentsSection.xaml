<UserControl x:Class="TidyMind.AttachmentsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TidyMind">
    <StackPanel>
        <!-- Drop zone: files dropped here (or picked with Browse) are copied in and listed below. Solid accent
             border and a light tint while files are dragged over it. -->
        <Border x:Name="DropZone" AllowDrop="True" Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="14,10"
                DragEnter="DropZone_DragEnter" DragOver="DropZone_DragOver"
                DragLeave="DropZone_DragLeave" Drop="DropZone_Drop">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="{StaticResource TextSub}" VerticalAlignment="Center" Margin="2,0,12,0"/>
                <TextBlock Grid.Column="1" Text="{local:Tr Files.DropHere}" FontSize="13" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSub}" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="{local:Tr Files.Browse}" Style="{StaticResource GhostButtonStyle}"
                        Height="32" Padding="14,0" Click="BrowseButton_Click"/>
            </Grid>
        </Border>

        <!-- The attached files, all of them: the window scrolls, not the list (like the task list). -->
        <StackPanel x:Name="FileRows" Margin="0,8,0,0" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
