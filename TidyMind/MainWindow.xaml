<Window x:Class="TidyMind.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TidyMind"
        mc:Ignorable="d"
        Title="TidyMind" Height="720" Width="1160"
        MinHeight="520" MinWidth="880"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Grid.Column="0" Background="{StaticResource Sidebar}">
            <DockPanel>
                <!-- Wordmark -->
                <Border DockPanel.Dock="Top" Padding="22,22,20,18">
                    <TextBlock Text="TIDYMIND" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource SidebarText}">
                        <TextBlock.LayoutTransform>
                            <ScaleTransform/>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Border>

                <!-- A newer version is known (Updates.Available): stays until it's installed or skipped; opens the update
                     dialog. Shown without taking the focus. -->
                <Button x:Name="UpdateIndicator" DockPanel.Dock="Top" Visibility="Collapsed" Margin="14,0,14,12" Height="32"
                        Padding="10,0" HorizontalContentAlignment="Left" Click="UpdateIndicator_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock x:Name="UpdateIndicatorText" Grid.Column="1" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Button>

                <!-- Bottom: New Project / New Collection, then Settings with the language switch beside it -->
                <Border DockPanel.Dock="Bottom" Padding="14,10,14,16">
                    <StackPanel>
                        <!-- The two New buttons together: the guided tour points at them -->
                        <StackPanel x:Name="NewButtons">
                            <Button Height="36" HorizontalContentAlignment="Left" Padding="14,0"
                                    Click="NewProjectButton_Click">
                                <TextBlock TextTrimming="CharacterEllipsis"><Run Text="+  "/><Run Text="{local:Tr Main.NewProject}"/></TextBlock>
                            </Button>
                            <Button Height="36" Margin="0,8,0,0"
                                    HorizontalContentAlignment="Left" Padding="14,0"
                                    Click="NewCollectionButton_Click">
                                <TextBlock TextTrimming="CharacterEllipsis"><Run Text="+  "/><Run Text="{local:Tr Main.NewCollection}"/></TextBlock>
                            </Button>
                        </StackPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Height="34" HorizontalContentAlignment="Left" Padding="10,0"
                                    Background="#3A3935" Foreground="{StaticResource SidebarText}"
                                    Click="SettingsButton_Click">
                                <TextBlock TextTrimming="CharacterEllipsis"><Run Text="⚙  "/><Run Text="{local:Tr Settings.Title}"/></TextBlock>
                            </Button>
                            <!-- The language switch: globe and the current language's code; a click lists the three
                                 languages, each named in its own language (MainWindow.LanguageButton_Click). -->
                            <Button x:Name="LanguageButton" Grid.Column="1" Height="34" MinWidth="58" Margin="8,0,0,0"
                                    Padding="10,0" Background="#3A3935" Foreground="{StaticResource SidebarText}"
                                    ToolTip="{local:Tr Language.Button.Tooltip}" Click="LanguageButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LanguageCode" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- While memories are selected (Ctrl or Shift+click): how many, and Delete / Cancel for all of them -->
                <Border x:Name="NavSelectionBar" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="14,8,14,0"
                        Padding="10,8,10,10" CornerRadius="8" Background="#2A2926">
                    <StackPanel>
                        <TextBlock x:Name="NavSelectionCount" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource SidebarText}" TextTrimming="CharacterEllipsis"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Height="30" Padding="8,0" Margin="0,0,4,0" Background="#3A3935"
                                    Foreground="#FF9A8C" Content="{local:Tr Common.Delete}" Click="NavDeleteSelected_Click"/>
                            <Button Grid.Column="1" Height="30" Padding="8,0" Margin="4,0,0,0" Background="#3A3935"
                                    Foreground="{StaticResource SidebarText}" Content="{local:Tr Common.Cancel}"
                                    ToolTip="{local:Tr Selection.ClearTip}" Click="NavClearSelection_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Nav tree. Ctrl, Shift+click, Ctrl+A select memories (ItemSelection); Delete deletes them. -->
                <ScrollViewer x:Name="NavScroll" VerticalScrollBarVisibility="Auto" FocusVisualStyle="{x:Null}">
                    <StackPanel x:Name="NavPanel" Margin="10,4,10,4"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Content ===== -->
        <Grid Grid.Column="1" Background="{StaticResource BgMain}">
            <ContentControl x:Name="ContentArea"/>

            <!-- Corner utility buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,24,20" Panel.ZIndex="100">
                <StackPanel x:Name="OverlayButtons" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="📝" ToolTip="{local:Tr Main.Corner.QuickNotes}"
                            AutomationProperties.Name="{local:Tr Main.Help.QuickNotes}"
                            Width="40" Height="40" FontSize="16" Padding="0,0,4,0" Margin="0,0,12,0"
                            Click="QuickNotesButton_Click"/>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="🔔" ToolTip="{local:Tr Main.Corner.Reminders}"
                            AutomationProperties.Name="{local:Tr Main.Help.Reminders}"
                            Width="40" Height="40" FontSize="16" Margin="0,0,12,0"
                            Click="RemindersIconButton_Click"/>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="📅" ToolTip="{local:Tr Main.Corner.Calendar}"
                            AutomationProperties.Name="{local:Tr Main.Help.Calendar}"
                            Width="40" Height="40" FontSize="16" Margin="0,0,12,0"
                            Click="CalendarIconButton_Click"/>
                </StackPanel>
                <Button x:Name="HelpButton" Style="{StaticResource IconButtonStyle}"
                        Content="?" ToolTip="{local:Tr Main.Corner.Help}" FontWeight="Bold"
                        AutomationProperties.Name="{local:Tr Main.Corner.Help}"
                        Width="40" Height="40" FontSize="16"
                        Click="HelpButton_Click"/>
            </StackPanel>

            <Popup x:Name="HelpPopup" PlacementTarget="{Binding ElementName=HelpButton}"
                   Placement="Top" StaysOpen="False" AllowsTransparency="True" Opened="HelpPopup_Opened">
                <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" Padding="14" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="{local:Tr Main.Help.Title}" FontWeight="Bold" FontSize="13"
                                   Foreground="{StaticResource Accent}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl+Shift+C" FontFamily="Consolas"
                                       FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,4,10,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Foreground="{StaticResource TextSub}" Margin="0,4,0,0"><Run Text="— "/><Run Text="{local:Tr Main.Help.Calendar}"/></TextBlock>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+Shift+F" FontFamily="Consolas"
                                       FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,4,10,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Foreground="{StaticResource TextSub}" Margin="0,4,0,0"><Run Text="— "/><Run Text="{local:Tr Main.Help.Search}"/></TextBlock>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl+Shift+N" FontFamily="Consolas"
                                       FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,0,10,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Foreground="{StaticResource TextSub}" Margin="0,0,0,4"><Run Text="— "/><Run Text="{local:Tr Main.Help.QuickNotes}"/></TextBlock>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+Shift+R" FontFamily="Consolas"
                                       FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Foreground="{StaticResource TextSub}"><Run Text="— "/><Run Text="{local:Tr Main.Help.Reminders}"/></TextBlock>
                        </Grid>
                        <TextBlock Text="{local:Tr Main.Help.DayPlan}"
                                   Foreground="{StaticResource TextSub}" FontSize="12" TextWrapping="Wrap" MaxWidth="250"
                                   HorizontalAlignment="Left" Margin="0,12,0,0"/>
                        <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Margin="0,12,0,8"/>
                        <!-- Everything else: every gesture and key, the tour, this release's news, the examples -->
                        <StackPanel>
                            <StackPanel.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource LinkButtonStyle}">
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Foreground" Value="{StaticResource BtnHover}"/>
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="Margin" Value="0,2,0,2"/>
                                </Style>
                            </StackPanel.Resources>
                            <Button x:Name="TipsLink" Content="{local:Tr Tips.Title}" Click="Tips_Click"/>
                            <Button x:Name="TakeTourLink" Content="{local:Tr Tour.HelpEntry}" Click="TakeTour_Click"/>
                            <Button x:Name="WhatsNewLink" Content="{local:Tr Help.WhatsNew}" Click="WhatsNew_Click"/>
                            <Button x:Name="AddExamplesLink" Content="{local:Tr Examples.Add}" Click="AddExamples_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <!-- Calendar (Ctrl+Shift+C): slides in from the right edge -->
        <local:CalendarPanel x:Name="CalendarPanel" Grid.ColumnSpan="2" Panel.ZIndex="150"/>

        <!-- Global search (Ctrl+Shift+F): covers sidebar and content alike -->
        <local:GlobalSearchOverlay x:Name="SearchOverlay" Grid.ColumnSpan="2" Panel.ZIndex="200"/>
    </Grid>
</Window>
