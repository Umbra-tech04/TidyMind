<Window x:Class="TidyMind.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TidyMind"
        mc:Ignorable="d"
        Title="TidyMind" Height="720" Width="1160"
        MinHeight="520" MinWidth="880"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Grid.Column="0" Background="{StaticResource Sidebar}">
            <DockPanel>
                <!-- Wordmark -->
                <Border DockPanel.Dock="Top" Padding="22,22,20,18">
                    <TextBlock Text="TIDYMIND" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource SidebarText}">
                        <TextBlock.LayoutTransform>
                            <ScaleTransform/>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Border>

                <!-- Bottom: New Project / New Collection + Settings -->
                <Border DockPanel.Dock="Bottom" Padding="14,10,14,16">
                    <StackPanel>
                        <Button x:Name="NewProjectButton" Content="+  New Project"
                                Height="36" HorizontalContentAlignment="Left" Padding="14,0"
                                Click="NewProjectButton_Click"/>
                        <Button x:Name="NewCollectionButton" Content="+  New Collection"
                                Height="36" Margin="0,8,0,0"
                                HorizontalContentAlignment="Left" Padding="14,0"
                                Click="NewCollectionButton_Click"/>
                        <Button x:Name="SettingsButton" Content="⚙  Settings"
                                Height="34" Margin="0,8,0,0"
                                HorizontalContentAlignment="Left" Padding="14,0"
                                Background="#3A3935" Foreground="{StaticResource SidebarText}"
                                Click="SettingsButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- Nav tree -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NavPanel" Margin="10,4,10,4"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Content ===== -->
        <Grid Grid.Column="1" Background="{StaticResource BgMain}">
            <ContentControl x:Name="ContentArea"/>

            <!-- Corner utility buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,24,20" Panel.ZIndex="100">
                <Button x:Name="QuickNotesButton" Style="{StaticResource IconButtonStyle}"
                        Content="📝" ToolTip="Quick Notes  (Ctrl+Shift+N)"
                        Width="40" Height="40" FontSize="16" Padding="0,0,4,0" Margin="0,0,12,0"
                        Click="QuickNotesButton_Click"/>
                <Button x:Name="RemindersIconButton" Style="{StaticResource IconButtonStyle}"
                        Content="🔔" ToolTip="Reminders  (Ctrl+Shift+R)"
                        Width="40" Height="40" FontSize="16" Margin="0,0,12,0"
                        Click="RemindersIconButton_Click"/>
                <Button x:Name="CalendarIconButton" Style="{StaticResource IconButtonStyle}"
                        Content="📅" ToolTip="Calendar  (Ctrl+Shift+C)"
                        Width="40" Height="40" FontSize="16" Margin="0,0,12,0"
                        Click="CalendarIconButton_Click"/>
                <Button x:Name="HelpButton" Style="{StaticResource IconButtonStyle}"
                        Content="?" ToolTip="Shortcuts" FontWeight="Bold"
                        Width="40" Height="40" FontSize="16"
                        Click="HelpButton_Click"/>
            </StackPanel>

            <Popup x:Name="HelpPopup" PlacementTarget="{Binding ElementName=HelpButton}"
                   Placement="Top" StaysOpen="False" AllowsTransparency="True">
                <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" Padding="14" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="Keyboard Shortcuts" FontWeight="Bold" FontSize="13"
                                   Foreground="{StaticResource Accent}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl+Shift+C" FontFamily="Consolas"
                                       FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,4,10,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="— Calendar"
                                       Foreground="{StaticResource TextSub}" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+Shift+F" FontFamily="Consolas"
                                       FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,4,10,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="— Search everything"
                                       Foreground="{StaticResource TextSub}" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl+Shift+N" FontFamily="Consolas"
                                       FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,0,10,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="— Quick Notes"
                                       Foreground="{StaticResource TextSub}" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+Shift+R" FontFamily="Consolas"
                                       FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="— Reminders"
                                       Foreground="{StaticResource TextSub}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <!-- Calendar (Ctrl+Shift+C): slides in from the right edge -->
        <local:CalendarPanel x:Name="CalendarPanel" Grid.ColumnSpan="2" Panel.ZIndex="150"/>

        <!-- Global search (Ctrl+Shift+F): covers sidebar and content alike -->
        <local:GlobalSearchOverlay x:Name="SearchOverlay" Grid.ColumnSpan="2" Panel.ZIndex="200"/>
    </Grid>
</Window>
