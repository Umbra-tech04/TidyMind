<UserControl x:Class="TidyMind.MemoryTodoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <!-- A plain list panel, deliberately unlike the project cards below it -->
    <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="1"
            CornerRadius="10" Padding="16,12,12,10">
        <StackPanel>
            <Grid Margin="0,0,4,8">
                <TextBlock Text="TO-DO" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSub}"/>
                <TextBlock x:Name="CountText" FontSize="10" Foreground="{StaticResource TextSub}" HorizontalAlignment="Right"/>
            </Grid>

            <Grid Margin="0,0,4,0">
                <TextBox x:Name="Input" Height="32" VerticalContentAlignment="Center"
                         KeyDown="Input_KeyDown" TextChanged="Input_TextChanged"
                         LostKeyboardFocus="Input_LostKeyboardFocus"/>
                <TextBlock x:Name="Placeholder" Text="Add a to-do and press Enter…" Foreground="{StaticResource TextSub}"
                           Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>

            <TextBlock x:Name="ErrorText" FontSize="12" Foreground="{StaticResource Danger}" TextWrapping="Wrap"
                       Margin="0,6,4,0" Visibility="Collapsed"/>

            <!-- Long lists scroll here instead of pushing the projects off the screen -->
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                <StackPanel x:Name="ItemList" Margin="0,0,4,0"/>
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>
