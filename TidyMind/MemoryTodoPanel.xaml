<UserControl x:Class="TidyMind.MemoryTodoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TidyMind">
    <UserControl.Resources>
        <!-- The header row as one flat button: click, Enter or Space folds the panel -->
        <Style x:Key="FoldHeaderStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="8" Padding="5,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgMain}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- A plain list panel with the cards' corner radius. It folds to its header line, and the list shows about four
         rows and scrolls, so the project cards below always keep the room. -->
    <Border x:Name="Frame" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="1"
            CornerRadius="16">
        <StackPanel>
            <Button x:Name="Header" Style="{StaticResource FoldHeaderStyle}" Click="Header_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Arrow" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="{StaticResource TextSub}"
                               VerticalAlignment="Center" Margin="0,1,8,0"/>
                    <TextBlock Grid.Column="1" Text="{local:Tr Todo.Header}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSub}" VerticalAlignment="Center"/>
                    <!-- Folded: the first open to-do, so the panel still says what's next -->
                    <TextBlock x:Name="NextText" Grid.Column="2" FontSize="12" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="14,0,14,0">
                        <Run Text="{local:Tr Todo.Next}" Foreground="{StaticResource TextSub}"/>
                        <Run x:Name="NextRun" Foreground="{StaticResource TextBody}"/>
                    </TextBlock>
                    <TextBlock x:Name="CountText" Grid.Column="3" FontSize="10" Foreground="{StaticResource TextSub}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <StackPanel x:Name="Body" Margin="6,0,6,0">
                <Grid>
                    <TextBox x:Name="Input" Height="32" VerticalContentAlignment="Center"
                             AutomationProperties.Name="{local:Tr Todo.PlaceholderEnter}"
                             KeyDown="Input_KeyDown" TextChanged="Input_TextChanged"/>
                    <TextBlock x:Name="Placeholder" Text="{local:Tr Todo.PlaceholderEnter}" Foreground="{StaticResource TextSub}"
                               Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>

                <TextBlock x:Name="ErrorText" FontSize="12" Foreground="{StaticResource Danger}" TextWrapping="Wrap"
                           Margin="0,6,0,0" Visibility="Collapsed"/>

                <!-- About four rows, then it scrolls; at either end the wheel moves on to the cards. Ctrl or Shift+click,
                     Ctrl+A select several (ItemSelection); Delete deletes them. -->
                <ScrollViewer x:Name="ListScroll" MaxHeight="124" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"
                              FocusVisualStyle="{x:Null}"
                              PreviewMouseWheel="ListScroll_PreviewMouseWheel">
                    <StackPanel x:Name="ItemList"/>
                </ScrollViewer>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
