<Window x:Class="TidyMind.CollectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TidyMind"
        mc:Ignorable="d"
        Title="Collection" Height="500" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#252526" Padding="20,14">
            <Grid>
                <TextBlock x:Name="CollectionTitle" Text="Collection"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#569CD6"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RemindersButton" Content="🔔 Reminders"
                            Width="120" Height="30" Margin="0,0,10,0"
                            Click="RemindersButton_Click"/>
                    <Button x:Name="SwitchProfileButton" Content="Switch Memory"
                            Width="130" Height="30"
                            Click="SwitchProfileButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Kereső -->
        <Border Grid.Row="1" Background="#1E1E1E" Padding="20,12,20,0">
            <TextBox x:Name="SearchBox" Height="32"
                     VerticalContentAlignment="Center"
                     Background="#3C3C3C" Foreground="#858585"
                     BorderBrush="#474747"
                     Text="Search..."
                     GotFocus="SearchBox_GotFocus"
                     LostFocus="SearchBox_LostFocus"
                     TextChanged="SearchBox_TextChanged"/>
        </Border>

        <!-- Entitás kártyák -->
        <ScrollViewer Grid.Row="2" Background="#1E1E1E"
                      VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="EntityPanel"
                       HorizontalAlignment="Center"
                       Margin="20,20,20,20"/>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#252526" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="AddEntityButton" Content="+ Add Entity"
                        Width="140" Height="34" Margin="0,0,16,0"
                        Click="AddEntityButton_Click"/>
                <TextBlock Text="Right-click an entity to delete"
                           FontSize="11" Foreground="#858585"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Button x:Name="QuickNotesButton" Grid.RowSpan="4"
                Style="{StaticResource IconButtonStyle}"
                Content="📝" ToolTip="Quick Notes (Ctrl+Shift+N)"
                Width="36" Height="36" FontSize="16" Padding="0,0,6,0"
                Background="#3C3C3C"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,16,74" Panel.ZIndex="100"
                Click="QuickNotesButton_Click"/>

        <!-- Overlay -->
        <Grid x:Name="OverlayGrid" Grid.RowSpan="4"
              Background="#AA000000"
              Visibility="Collapsed"
              MouseLeftButtonDown="OverlayGrid_MouseLeftButtonDown">
            <Grid.OpacityMask>
                <SolidColorBrush Color="Black"/>
            </Grid.OpacityMask>

            <Border x:Name="DetailCard"
                    Background="#252526"
                    CornerRadius="12"
                    Padding="0"
                    MaxWidth="700"
                    MaxHeight="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MouseLeftButtonDown="DetailCard_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Bal: Kép -->
                    <Border Grid.Column="0"
                            Background="#1E1E1E"
                            CornerRadius="12,0,0,12">
                        <Image x:Name="DetailImage"
                               Stretch="Uniform"
                               Margin="16"/>
                    </Border>

                    <!-- Jobb: Adatok -->
                    <Grid Grid.Column="1" Margin="24,20,24,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Név + X gomb -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock x:Name="DetailName"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                            <Button Content="✕" Width="32" Height="32"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    Click="CloseOverlay_Click"/>
                        </Grid>

                        <!-- Adatok -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      Background="Transparent">
                            <StackPanel x:Name="DetailPanel"/>
                        </ScrollViewer>

                        <!-- Gombok -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal"
                                    HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button x:Name="DetailEditButton" Content="Edit"
                                    Width="90" Height="34" Margin="0,0,10,0"
                                    Click="DetailEditButton_Click"/>
                            <Button x:Name="DetailDeleteButton" Content="Delete"
                                    Width="90" Height="34"
                                    Background="#8B1A1A"
                                    Click="DetailDeleteButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>