<UserControl x:Class="TidyMind.QuickTodoListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TidyMind"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="420">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <TextBox x:Name="Input" Height="32" VerticalContentAlignment="Center"
                         AutomationProperties.Name="{local:Tr Todo.Placeholder}"
                         KeyDown="Input_KeyDown" TextChanged="Input_TextChanged"/>
                <TextBlock x:Name="Placeholder" Text="{local:Tr Todo.Placeholder}" Foreground="{StaticResource TextSub}"
                           Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>

            <Border Grid.Column="1" Margin="8,0,0,0" Height="32" Padding="2"
                    Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="4">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="{local:Tr Common.Today}"
                                 Style="{StaticResource SegmentStyle}" IsChecked="True"/>
                    <RadioButton x:Name="TomorrowButton" Content="{local:Tr Common.Tomorrow}"
                                 Style="{StaticResource SegmentStyle}"/>
                </StackPanel>
            </Border>

            <Button Grid.Column="2" Content="{local:Tr Todo.Add}" Height="32" Margin="8,0,0,0" Padding="14,0"
                    Click="AddButton_Click"/>
        </Grid>

        <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource Danger}" Margin="2,6,0,0" Visibility="Collapsed"/>

        <!-- Ctrl or Shift+click, Ctrl+A select several (ItemSelection); Delete deletes them -->
        <StackPanel x:Name="TodoList" Margin="0,10,0,0" Focusable="True" FocusVisualStyle="{x:Null}" Background="Transparent"/>
        <TextBlock x:Name="EmptyText" Foreground="{StaticResource TextSub}" Margin="2,4,0,4" Visibility="Collapsed"/>

        <Button x:Name="DoneToggle" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left"
                Margin="0,6,0,0" Visibility="Collapsed" Click="DoneToggle_Click"/>
    </StackPanel>
</UserControl>
