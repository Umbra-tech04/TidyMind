<Window x:Class="TidyMind.EntityForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TidyMind"
        mc:Ignorable="d"
        Title="Add Entity" Height="650" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMain}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="20,16">
            <TextBlock x:Name="FormTitle" Text="Add Entity" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextMain}"/>
        </Border>

        <ScrollViewer Grid.Row="1" Background="{StaticResource BgMain}" Padding="20,14"
                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
            <StackPanel x:Name="FormPanel"/>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="20,10">
            <Button x:Name="SaveButton" Content="Save"
                    Width="120" Height="34" HorizontalAlignment="Right"
                    FontWeight="Bold"
                    Click="SaveButton_Click"/>
        </Border>
    </Grid>
</Window>
