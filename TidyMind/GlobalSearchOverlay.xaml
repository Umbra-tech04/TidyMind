<UserControl x:Class="TidyMind.GlobalSearchOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             KeyboardNavigation.TabNavigation="Cycle"
             PreviewKeyDown="Overlay_PreviewKeyDown">
    <Grid x:Name="Backdrop" Background="#77000000"
          MouseLeftButtonDown="Backdrop_MouseLeftButtonDown"
          SizeChanged="Backdrop_SizeChanged">
        <Border x:Name="Card" Width="640"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource Border}" BorderThickness="1"
                CornerRadius="12"
                MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
            </Border.Effect>
            <StackPanel>
                <!-- Search input -->
                <Grid Margin="20,16,16,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="{StaticResource Accent}"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>

                    <Grid Grid.Column="1">
                        <TextBlock x:Name="Placeholder" Text="Search memories, projects and items…"
                                   FontSize="19" Foreground="#A5A5A2"
                                   VerticalAlignment="Center" Margin="2,0,0,0"
                                   IsHitTestVisible="False"/>
                        <TextBox x:Name="QueryBox" FontSize="19"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 Foreground="{StaticResource TextMain}"
                                 CaretBrush="{StaticResource Accent}"
                                 VerticalContentAlignment="Center"
                                 TextChanged="QueryBox_TextChanged">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden"/>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </Grid>

                    <Border Grid.Column="2" Background="{StaticResource BgSubtle}" CornerRadius="4"
                            Padding="7,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Esc" FontSize="11" Foreground="{StaticResource TextSub}"/>
                    </Border>
                </Grid>

                <!-- Results -->
                <Border x:Name="ResultsArea" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <ScrollViewer x:Name="ResultsScroller" MaxHeight="360"
                                      VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel x:Name="ResultsPanel" Margin="8"/>
                        </ScrollViewer>
                        <TextBlock x:Name="MessageText" FontSize="13" Foreground="{StaticResource TextSub}"
                                   HorizontalAlignment="Center" Margin="0,22,0,22"
                                   Visibility="Collapsed"/>
                        <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="20,8">
                            <TextBlock FontSize="11" Foreground="{StaticResource TextSub}"
                                       Text="↑ ↓  to move    ·    Enter  to open    ·    Esc  to close"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
