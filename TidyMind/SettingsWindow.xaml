<Window x:Class="TidyMind.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TidyMind"
        mc:Ignorable="d"
        Title="Settings" Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMain}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="20,16">
            <TextBlock Text="⚙  Settings" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextMain}"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="20,18">
            <TextBlock Text="DATA" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSub}" Margin="0,0,0,8"/>
            <Button x:Name="ExportAllButton" Content="Export All Memories…"
                    Height="38" HorizontalContentAlignment="Left" Padding="14,0"
                    Click="ExportAllButton_Click"/>

            <TextBlock Text="More settings are on the way." FontSize="12"
                       Foreground="{StaticResource TextSub}" FontStyle="Italic"
                       HorizontalAlignment="Center" Margin="0,26,0,4"/>
        </StackPanel>
    </Grid>
</Window>
