<Window x:Class="TidyMind.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgMain}">
    <Window.Resources>
        <!-- Section headings, as in Project Details -->
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B6965"/>
            <Setter Property="Margin" Value="2,20,0,8"/>
        </Style>

        <!-- A group of rows: a white card like the other panels -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <!-- One setting: what it does on the left, its button on the right -->
        <Style x:Key="RowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="16,12"/>
        </Style>
        <Style x:Key="RowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>
        <Style x:Key="RowNoteStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RowButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="16,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource Border}"/>
            <Setter Property="Margin" Value="16,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,22,24,20">
        <TextBlock Text="Settings" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>

        <TextBlock Text="Backup" Style="{StaticResource SectionLabelStyle}" Margin="2,16,0,8"/>
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <Grid Style="{StaticResource RowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Back up all data" Style="{StaticResource RowTitleStyle}"/>
                        <TextBlock Text="Saves everything TidyMind stores to one ZIP file." Style="{StaticResource RowNoteStyle}"/>
                    </StackPanel>
                    <Button Content="Back up…" Style="{StaticResource RowButtonStyle}" Click="BackupButton_Click"/>
                </Grid>
                <Border Style="{StaticResource RowDividerStyle}"/>
                <Grid Style="{StaticResource RowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Restore from backup" Style="{StaticResource RowTitleStyle}"/>
                        <TextBlock Text="Replaces the current data. TidyMind restarts." Style="{StaticResource RowNoteStyle}"/>
                    </StackPanel>
                    <Button Content="Restore…" Style="{StaticResource RowButtonStyle}" Click="RestoreButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Text="Data" Style="{StaticResource SectionLabelStyle}"/>
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <Grid Style="{StaticResource RowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Export all memories" Style="{StaticResource RowTitleStyle}"/>
                        <TextBlock Text="A readable report, not a backup." Style="{StaticResource RowNoteStyle}"/>
                    </StackPanel>
                    <Button Content="Export…" Style="{StaticResource RowButtonStyle}" Click="ExportAllButton_Click"/>
                </Grid>
                <Border Style="{StaticResource RowDividerStyle}"/>
                <Grid Style="{StaticResource RowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Open data folder" Style="{StaticResource RowTitleStyle}"/>
                        <!-- The folder itself, cut short if it doesn't fit (the tooltip has all of it) -->
                        <TextBlock x:Name="DataFolderText" Style="{StaticResource RowNoteStyle}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Content="Open" Style="{StaticResource RowButtonStyle}" Click="OpenDataFolderButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- About: one quiet line. The link uses the darker accent, which reads at 5.7:1 on this background. -->
        <Grid Margin="2,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource TextSub}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Licenses" Style="{StaticResource LinkButtonStyle}"
                    Foreground="{StaticResource BtnHover}" Click="LicensesLink_Click"/>
        </Grid>
    </StackPanel>
</Window>
