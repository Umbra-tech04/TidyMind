<Window x:Class="TidyMind.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TidyMind"
        Title="{local:Tr Settings.Title}" Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgMain}">
    <Window.Resources>
        <!-- Section headings, as in Project Details -->
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B6965"/>
            <Setter Property="Margin" Value="2,20,0,8"/>
        </Style>

        <!-- A group of rows: a white card like the other panels -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <!-- One setting: what it does on the left, its button on the right -->
        <Style x:Key="RowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="16,12"/>
        </Style>
        <Style x:Key="RowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>
        <Style x:Key="RowNoteStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RowButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="16,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource Border}"/>
            <Setter Property="Margin" Value="16,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,22,24,20">
        <TextBlock Text="{local:Tr Settings.Title}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>

        <TextBlock Text="{local:Tr Settings.Section.General}" Style="{StaticResource SectionLabelStyle}" Margin="2,16,0,8"/>
        <Border Style="{StaticResource CardStyle}">
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{local:Tr Settings.Language.Title}" Style="{StaticResource RowTitleStyle}"/>
                    <TextBlock Text="{local:Tr Settings.Language.Note}" Style="{StaticResource RowNoteStyle}"/>
                </StackPanel>
                <!-- English / Magyar / Srpski, each named in its own language (filled from Loc.Languages) -->
                <Border Grid.Column="1" Margin="16,0,0,0" Height="32" Padding="2" VerticalAlignment="Center"
                        Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" CornerRadius="4">
                    <StackPanel x:Name="LanguageChoices" Orientation="Horizontal"
                                AutomationProperties.Name="{local:Tr Settings.Language.Title}"/>
                </Border>
            </Grid>
        </Border>

        <TextBlock Text="{local:Tr Settings.Section.Backup}" Style="{StaticResource SectionLabelStyle}"/>
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <Grid Style="{StaticResource RowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{local:Tr Settings.Backup.Title}" Style="{StaticResource RowTitleStyle}"/>
                        <TextBlock Text="{local:Tr Settings.Backup.Note}" Style="{StaticResource RowNoteStyle}"/>
                    </StackPanel>
                    <Button Content="{local:Tr Settings.Backup.Button}" Style="{StaticResource RowButtonStyle}" Click="BackupButton_Click"/>
                </Grid>
                <Border Style="{StaticResource RowDividerStyle}"/>
                <Grid Style="{StaticResource RowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{local:Tr Settings.Restore.Title}" Style="{StaticResource RowTitleStyle}"/>
                        <TextBlock Text="{local:Tr Settings.Restore.Note}" Style="{StaticResource RowNoteStyle}"/>
                    </StackPanel>
                    <Button Content="{local:Tr Settings.Restore.Button}" Style="{StaticResource RowButtonStyle}" Click="RestoreButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Text="{local:Tr Settings.Section.Data}" Style="{StaticResource SectionLabelStyle}"/>
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <Grid Style="{StaticResource RowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{local:Tr Settings.ExportAll.Title}" Style="{StaticResource RowTitleStyle}"/>
                        <TextBlock Text="{local:Tr Settings.ExportAll.Note}" Style="{StaticResource RowNoteStyle}"/>
                    </StackPanel>
                    <Button Content="{local:Tr Settings.ExportAll.Button}" Style="{StaticResource RowButtonStyle}" Click="ExportAllButton_Click"/>
                </Grid>
                <Border Style="{StaticResource RowDividerStyle}"/>
                <Grid Style="{StaticResource RowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{local:Tr Settings.DataFolder.Title}" Style="{StaticResource RowTitleStyle}"/>
                        <!-- The folder itself, cut short if it doesn't fit (the tooltip has all of it) -->
                        <TextBlock x:Name="DataFolderText" Style="{StaticResource RowNoteStyle}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Content="{local:Tr Settings.DataFolder.Button}" Style="{StaticResource RowButtonStyle}" Click="OpenDataFolderButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- About: one quiet line. The link uses the darker accent, which reads at 5.7:1 on this background. -->
        <Grid Margin="2,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource TextSub}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="{local:Tr Settings.Licenses}" Style="{StaticResource LinkButtonStyle}"
                    Foreground="{StaticResource BtnHover}" Click="LicensesLink_Click"/>
        </Grid>
    </StackPanel>
</Window>
