<Window x:Class="TidyMind.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TidyMind"
        Title="{local:Tr Settings.Title}" Width="900" Height="600" MinWidth="640" MinHeight="420"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgMain}">
    <Window.Resources>
        <!-- One setting: what it does on the left, its button on the right -->
        <Style x:Key="RowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="16,12"/>
        </Style>
        <Style x:Key="RowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>
        <Style x:Key="RowNoteStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RowButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="16,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource Border}"/>
            <Setter Property="Margin" Value="16,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- On/off switch (a CheckBox): a pill with a knob, accent when on -->
        <Style x:Key="SwitchStyle" TargetType="CheckBox">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Margin" Value="16,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="track" Width="40" Height="22" CornerRadius="11" Background="#C9C9C6">
                            <Ellipse x:Name="knob" Width="16" Height="16" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="3,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="track" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The categories on the left (arrow keys move between them), the chosen one's page on the right, which scrolls
         on its own. Each page holds the sections that were in the one long column before, unchanged. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,22,12,16">
                <TextBlock DockPanel.Dock="Top" Text="{local:Tr Settings.Title}" FontSize="17" FontWeight="Bold"
                           Foreground="{StaticResource TextMain}" Margin="12,0,0,14"/>
                <ListBox x:Name="CategoryList" MaxWidth="240" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource CategoryStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="{local:Tr Settings.Title}"
                         SelectionChanged="CategoryList_SelectionChanged">
                    <ListBoxItem Content="{local:Tr Settings.Section.General}"/>
                    <ListBoxItem Content="{local:Tr Settings.Category.Appearance}"/>
                    <ListBoxItem Content="{local:Tr Settings.Category.Reminders}"/>
                    <ListBoxItem Content="{local:Tr Settings.Category.Backup}"/>
                    <ListBoxItem Content="{local:Tr Settings.Section.Updates}"/>
                    <ListBoxItem Content="{local:Tr Settings.Category.About}"/>
                </ListBox>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <!-- Every page as wide as the pane, up to a readable width, so cards line up from page to page -->
            <Grid Margin="28,22,28,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="760"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- General -->
                <StackPanel x:Name="GeneralPage">
                    <TextBlock Text="{local:Tr Settings.Section.General}" Style="{StaticResource PageTitleStyle}"/>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Style="{StaticResource RowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{local:Tr Settings.Language.Title}" Style="{StaticResource RowTitleStyle}"/>
                                    <TextBlock Text="{local:Tr Settings.Language.Note}" Style="{StaticResource RowNoteStyle}"/>
                                </StackPanel>
                                <!-- English / Magyar / Srpski, each named in its own language (filled from Loc.Languages) -->
                                <Border Grid.Column="1" Margin="16,0,0,0" Height="32" Padding="2" VerticalAlignment="Center"
                                        Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                                        BorderThickness="1" CornerRadius="4">
                                    <StackPanel x:Name="LanguageChoices" Orientation="Horizontal"
                                                AutomationProperties.Name="{local:Tr Settings.Language.Title}"/>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}"/>
                            <!-- What amounts are shown in (Currency); empty: the Windows region's symbol. Applies as typed. -->
                            <Grid Style="{StaticResource RowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{local:Tr Settings.Currency.Title}" Style="{StaticResource RowTitleStyle}"/>
                                    <TextBlock x:Name="CurrencyNote" Style="{StaticResource RowNoteStyle}"/>
                                </StackPanel>
                                <TextBox x:Name="CurrencyBox" Grid.Column="1" Width="110" Height="32" Margin="16,0,0,0"
                                         VerticalAlignment="Center" VerticalContentAlignment="Center" MaxLength="12"
                                         AutomationProperties.Name="{local:Tr Settings.Currency.Title}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Appearance -->
                <StackPanel x:Name="AppearancePage" Visibility="Collapsed">
                    <TextBlock Text="{local:Tr Settings.Category.Appearance}" Style="{StaticResource PageTitleStyle}"/>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <!-- How clearly a memory's background picture shows (PageBackground.ImageVisibility); applies as it moves -->
                            <Grid Style="{StaticResource RowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{local:Tr Settings.BackgroundImage.Title}" Style="{StaticResource RowTitleStyle}"/>
                                    <TextBlock Text="{local:Tr Settings.BackgroundImage.Note}" Style="{StaticResource RowNoteStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Slider x:Name="BackgroundVisibilitySlider" Width="150" Minimum="20" Maximum="100" SmallChange="5"
                                            LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            AutomationProperties.Name="{local:Tr Settings.BackgroundImage.Title}"/>
                                    <TextBlock x:Name="BackgroundVisibilityText" Width="40" Margin="8,0,0,0" TextAlignment="Right"
                                               VerticalAlignment="Center" Foreground="{StaticResource TextSub}"/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}"/>
                            <!-- Frosted glass for the header plate and empty-tab card on a background picture (CardTint); applies at once -->
                            <Grid Style="{StaticResource RowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{local:Tr Settings.CardTint.Title}" Style="{StaticResource RowTitleStyle}"/>
                                    <TextBlock Text="{local:Tr Settings.CardTint.Note}" Style="{StaticResource RowNoteStyle}"/>
                                </StackPanel>
                                <CheckBox x:Name="CardTintSwitch" Style="{StaticResource SwitchStyle}"
                                          AutomationProperties.Name="{local:Tr Settings.CardTint.Title}"
                                          Click="CardTintSwitch_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Reminders -->
                <StackPanel x:Name="RemindersPage" Visibility="Collapsed">
                    <TextBlock Text="{local:Tr Settings.Category.Reminders}" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="{local:Tr Settings.Section.Notifications}" Style="{StaticResource SectionLabelStyle}" Margin="2,0,0,8"/>
                    <Border Style="{StaticResource CardStyle}">
                        <Grid Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{local:Tr Settings.Notify.Title}" Style="{StaticResource RowTitleStyle}"/>
                                <TextBlock x:Name="NotifyNote" Text="{local:Tr Settings.Notify.Note}" Style="{StaticResource RowNoteStyle}"/>
                            </StackPanel>
                            <Button x:Name="TestNotifyButton" Content="{local:Tr Settings.Notify.Button}" Style="{StaticResource RowButtonStyle}"
                                    Click="TestNotificationButton_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Backup & transfer -->
                <StackPanel x:Name="BackupPage" Visibility="Collapsed">
                    <TextBlock Text="{local:Tr Settings.Category.Backup}" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="{local:Tr Settings.Section.Backup}" Style="{StaticResource SectionLabelStyle}" Margin="2,0,0,8"/>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Style="{StaticResource RowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{local:Tr Settings.Backup.Title}" Style="{StaticResource RowTitleStyle}"/>
                                    <TextBlock Text="{local:Tr Settings.Backup.Note}" Style="{StaticResource RowNoteStyle}"/>
                                </StackPanel>
                                <Button Content="{local:Tr Settings.Backup.Button}" Style="{StaticResource RowButtonStyle}" Click="BackupButton_Click"/>
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}"/>
                            <Grid Style="{StaticResource RowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{local:Tr Settings.Restore.Title}" Style="{StaticResource RowTitleStyle}"/>
                                    <TextBlock Text="{local:Tr Settings.Restore.Note}" Style="{StaticResource RowNoteStyle}"/>
                                </StackPanel>
                                <Button Content="{local:Tr Settings.Restore.Button}" Style="{StaticResource RowButtonStyle}" Click="RestoreButton_Click"/>
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}"/>
                            <Grid Style="{StaticResource RowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{local:Tr Settings.Import.Title}" Style="{StaticResource RowTitleStyle}"/>
                                    <TextBlock Text="{local:Tr Settings.Import.Note}" Style="{StaticResource RowNoteStyle}"/>
                                </StackPanel>
                                <Button x:Name="ImportButton" Content="{local:Tr Settings.Import.Button}" Style="{StaticResource RowButtonStyle}" Click="ImportButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{local:Tr Settings.Section.Data}" Style="{StaticResource SectionLabelStyle}"/>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Style="{StaticResource RowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{local:Tr Settings.ExportAll.Title}" Style="{StaticResource RowTitleStyle}"/>
                                    <TextBlock Text="{local:Tr Settings.ExportAll.Note}" Style="{StaticResource RowNoteStyle}"/>
                                </StackPanel>
                                <Button Content="{local:Tr Settings.ExportAll.Button}" Style="{StaticResource RowButtonStyle}" Click="ExportAllButton_Click"/>
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}"/>
                            <Grid Style="{StaticResource RowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{local:Tr Settings.DataFolder.Title}" Style="{StaticResource RowTitleStyle}"/>
                                    <!-- The folder itself, cut short if it doesn't fit (the tooltip has all of it) -->
                                    <TextBlock x:Name="DataFolderText" Style="{StaticResource RowNoteStyle}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Content="{local:Tr Settings.DataFolder.Button}" Style="{StaticResource RowButtonStyle}" Click="OpenDataFolderButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Updates -->
                <StackPanel x:Name="UpdatesPage" Visibility="Collapsed">
                    <TextBlock Text="{local:Tr Settings.Section.Updates}" Style="{StaticResource PageTitleStyle}"/>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Style="{StaticResource RowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{local:Tr Settings.Updates.Auto.Title}" Style="{StaticResource RowTitleStyle}"/>
                                    <TextBlock Text="{local:Tr Settings.Updates.Auto.Note}" Style="{StaticResource RowNoteStyle}"/>
                                </StackPanel>
                                <CheckBox x:Name="AutoUpdateSwitch" Style="{StaticResource SwitchStyle}"
                                          AutomationProperties.Name="{local:Tr Settings.Updates.Auto.Title}"
                                          Click="AutoUpdateSwitch_Click"/>
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}"/>
                            <Grid Style="{StaticResource RowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="UpdateVersionText" Style="{StaticResource RowTitleStyle}"/>
                                    <!-- When it was last checked, or what "Check now" found -->
                                    <TextBlock x:Name="UpdateNote" Style="{StaticResource RowNoteStyle}"/>
                                </StackPanel>
                                <Button x:Name="CheckUpdatesButton" Content="{local:Tr Settings.Updates.Check}" Style="{StaticResource RowButtonStyle}"
                                        Click="CheckUpdatesButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- About: one quiet line. The link uses the darker accent, which reads at 5.7:1 on this background. -->
                <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                    <TextBlock Text="{local:Tr Settings.Category.About}" Style="{StaticResource PageTitleStyle}"/>
                    <Grid Margin="2,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource TextSub}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="{local:Tr Settings.Licenses}" Style="{StaticResource LinkButtonStyle}"
                                Foreground="{StaticResource BtnHover}" Click="LicensesLink_Click"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
