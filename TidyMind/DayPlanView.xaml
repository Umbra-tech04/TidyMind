<UserControl x:Class="TidyMind.DayPlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TidyMind"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="940"
             SizeChanged="View_SizeChanged">
    <!-- One day's plan: the time blocks as a timeline (or a list), and beside them the to-dos not yet on it. -->
    <Grid Background="{StaticResource BgMain}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: the day, moving between days, Timeline / List, Add block. On a narrow page the buttons go under
             the day (View_SizeChanged). -->
        <Grid Margin="32,24,32,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="WhenText" FontSize="13" Foreground="{StaticResource TextSub}"/>
                <TextBlock x:Name="DateText" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="Light"
                           Foreground="{StaticResource TextMain}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SummaryText" FontSize="12" Foreground="{StaticResource TextSub}" Margin="0,2,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- While blocks are selected (Ctrl or Shift+click, Ctrl+A), the selection bar stands in for these buttons -->
            <local:SelectionBar x:Name="SelectionBar" Grid.Column="1" VerticalAlignment="Bottom" Margin="16,0,0,2"
                                Visibility="Collapsed"/>
            <StackPanel x:Name="HeaderButtons" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"
                        Margin="16,0,0,2">
                <Button Style="{StaticResource HoverIconButtonStyle}" Content="&#xE76B;" ToolTip="{local:Tr Plan.PrevDay}" AutomationProperties.Name="{local:Tr Plan.PrevDay}"
                        Focusable="True" Click="PrevDay_Click"/>
                <Button x:Name="TodayButton" Content="{local:Tr Common.Today}" Style="{StaticResource GhostButtonStyle}" Height="30"
                        Padding="12,0" Margin="4,0" Click="Today_Click"/>
                <Button Style="{StaticResource HoverIconButtonStyle}" Content="&#xE76C;" ToolTip="{local:Tr Plan.NextDay}" AutomationProperties.Name="{local:Tr Plan.NextDay}"
                        Focusable="True" Click="NextDay_Click"/>

                <Border Margin="14,0,0,0" Height="30" Padding="2"
                        Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" CornerRadius="4">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TimelineButton" Content="{local:Tr Plan.Timeline}" Style="{StaticResource SegmentStyle}"
                                     Checked="ViewMode_Checked"/>
                        <RadioButton x:Name="ListButton" Content="{local:Tr Plan.List}" Style="{StaticResource SegmentStyle}"
                                     Checked="ViewMode_Checked"/>
                    </StackPanel>
                </Border>

                <Button x:Name="AddButton" Height="30" Padding="14,0" Margin="12,0,0,0"
                        Click="AddButton_Click">
                    <TextBlock><Run Text="+  "/><Run Text="{local:Tr Plan.AddBlock}"/></TextBlock>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="32,0,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- The day: a sheet like Home's to-do list. Its blocks can be selected several at once (ItemSelection). -->
            <Border x:Name="Sheet" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="12" ClipToBounds="True">
                <Grid>
                    <ScrollViewer x:Name="TimelineScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <!-- Hour scale, blocks, now line: built in code (ShowTimeline) -->
                        <Canvas x:Name="Surface" Background="Transparent" AllowDrop="True" Margin="0,10,0,10"
                                SizeChanged="Surface_SizeChanged"
                                MouseLeftButtonDown="Surface_MouseLeftButtonDown" MouseMove="Surface_MouseMove"
                                MouseLeftButtonUp="Surface_MouseLeftButtonUp" LostMouseCapture="Surface_LostMouseCapture"
                                DragOver="Surface_DragOver" DragLeave="Surface_DragLeave" Drop="Surface_Drop"/>
                    </ScrollViewer>

                    <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                                  Focusable="False">
                        <StackPanel x:Name="ListPanel" Margin="12,10,12,12"/>
                    </ScrollViewer>

                    <!-- dayplan.json can't be read: said here, and nothing can be changed (so it's never saved over) -->
                    <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" Margin="24"
                               VerticalAlignment="Top" FontSize="13" Foreground="{StaticResource TextBody}"/>
                </Grid>
            </Border>

            <!-- To-dos not on this day's plan yet. The bottom margin clears the corner buttons. -->
            <DockPanel Grid.Column="2" Margin="0,0,0,56">
                <TextBlock DockPanel.Dock="Top" Text="{local:Tr Plan.Todos}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMain}"/>
                <TextBlock DockPanel.Dock="Top" FontSize="12" Foreground="{StaticResource TextSub}" TextWrapping="Wrap"
                           Margin="0,4,0,10"
                           Text="{local:Tr Plan.TodosHint}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel x:Name="TodoPanel"/>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
