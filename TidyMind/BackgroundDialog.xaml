<Window x:Class="TidyMind.BackgroundDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Background" Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgMain}">
    <!-- Shared by Customize Card and Edit Background (see CardCustomizeDialog / MemoryBackgroundDialog).
         Same light dialog look as InputDialog and the calendar's day dialog. -->
    <StackPanel Margin="24,22,24,20">
        <TextBlock x:Name="HeadingText" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
        <TextBlock x:Name="SubheadingText" FontSize="12" Foreground="{StaticResource TextSub}" Margin="0,4,0,0"
                   TextTrimming="CharacterEllipsis"/>

        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Live preview: the real card, or the page behind its cards -->
            <ContentControl x:Name="Preview" VerticalAlignment="Top" Focusable="False"/>

            <StackPanel Grid.Column="2">
                <TextBlock Text="COLOR" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSub}" Margin="0,0,0,8"/>
                <UniformGrid x:Name="SwatchPanel" Columns="5" HorizontalAlignment="Left"/>

                <TextBlock Text="IMAGE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSub}" Margin="0,18,0,8"/>
                <Button Content="Choose Image…" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left"
                        Height="34" Padding="14,0" Click="ChooseImage_Click"/>
                <TextBlock x:Name="ImageText" FontSize="11" Foreground="{StaticResource TextSub}" Margin="0,6,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>

        <Grid Margin="0,22,0,0">
            <Button x:Name="RemoveButton" Content="Remove customization" HorizontalAlignment="Left"
                    Style="{StaticResource GhostButtonStyle}" Foreground="{StaticResource Danger}"
                    Height="36" Padding="14,0" Click="Remove_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource GhostButtonStyle}"
                        Width="92" Height="36" Margin="0,0,10,0"/>
                <Button Content="Save" IsDefault="True" Width="104" Height="36" FontWeight="SemiBold"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
