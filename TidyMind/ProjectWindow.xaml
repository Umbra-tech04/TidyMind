<Window x:Class="TidyMind.ProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TidyMind"
        mc:Ignorable="d"
        Title="Project Details" Height="620" Width="540"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#252526" Padding="20,14">
            <TextBlock Text="Project Details" FontSize="18" FontWeight="Bold"
                       Foreground="#569CD6"/>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="20,14" Background="#1E1E1E">
            <StackPanel>
                <TextBlock Text="Project Name" Foreground="#858585" FontSize="11" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Height="32" VerticalContentAlignment="Center"/>

                <TextBlock Text="Description" Foreground="#858585" FontSize="11" Margin="0,12,0,4"/>
                <TextBox x:Name="DescriptionBox" Height="120"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>

                <TextBlock Text="Status" Foreground="#858585" FontSize="11" Margin="0,12,0,4"/>
                <ComboBox x:Name="StatusBox" Height="32"
                          ItemsSource="{Binding Source={x:Static local:ProjectStatusItems.All}}"/>

                <TextBlock Text="Tasks" Foreground="#858585" FontSize="11" Margin="0,12,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox x:Name="TaskInput" Width="270" Height="32"
                             VerticalContentAlignment="Center"/>
                    <Button x:Name="AddTaskButton" Content="Add Task"
                            Height="32" Margin="10,0,0,0" Padding="12,0"
                            Click="AddTaskButton_Click"/>
                    <TextBlock Text="Right-click to edit"
                               FontSize="11" Foreground="#858585"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <ListBox x:Name="TaskList" MinHeight="80"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         PreviewMouseWheel="TaskList_PreviewMouseWheel"
                         PreviewMouseRightButtonUp="TaskList_PreviewMouseRightButtonUp">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Title}" IsChecked="{Binding IsDone}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="Notes" Foreground="#858585" FontSize="11" Margin="0,12,0,4"/>
                <Border Background="#252526" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                    <TextBlock x:Name="NoteText" Text="No notes"
                               FontSize="13" Foreground="#858585"
                               TextWrapping="Wrap" MinHeight="50"/>
                </Border>
                <Button x:Name="NoteButton" Content="Add Note"
                        Width="110" Height="30" HorizontalAlignment="Left"
                        Click="NoteButton_Click"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#252526" Padding="20,10">
            <Button x:Name="SaveButton" Content="Save"
                    Width="120" Height="34" HorizontalAlignment="Right"
                    Background="#0E639C" Foreground="#FFFFFF" FontWeight="Bold"
                    Click="SaveButton_Click"/>
        </Border>
    </Grid>
</Window>