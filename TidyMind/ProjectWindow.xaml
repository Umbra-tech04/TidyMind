<Window x:Class="TidyMind.ProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TidyMind"
        mc:Ignorable="d"
        Title="{local:Tr ProjectWindow.Title}" Width="580" Height="670" MinWidth="560" MinHeight="540"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMain}">
    <Window.Resources>
        <!-- Section headings: readable at a glance, still clearly labels -->
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B6965"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- The thin rule between sections -->
        <Style x:Key="SectionDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#E4E2DD"/>
            <Setter Property="Margin" Value="0,16"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Single-line inputs (name, new task): rounded like the app's dialogs, accent edge when focused -->
        <Style x:Key="FieldStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                                BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <!-- Placeholder: the box's Tag, shown while it's empty -->
                                <TextBlock x:Name="placeholder" Text="{TemplateBinding Tag}" Margin="12,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextSub}"
                                           FontWeight="Normal" IsHitTestVisible="False" Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="10,0" VerticalAlignment="Center"
                                              Focusable="False" HorizontalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#BDBDB9"/>
                            </Trigger>
                            <!-- After the Text trigger, so it wins: the placeholder goes as soon as the box is clicked into -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="placeholder" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The notes page's ruled lines. They sit under each line of text because every paragraph line is exactly
             24 tall (the Paragraph style in NotesBox, BlockLineHeight) and each tile is that same height, starting
             where the text starts: keep the 24s in step. -->
        <DrawingBrush x:Key="NotebookRules" TileMode="Tile" Stretch="None"
                      Viewport="0,0,8,24" ViewportUnits="Absolute"
                      Viewbox="0,0,8,24" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,8,24"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#ECEAE4">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,23,8,1"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- A row in the ☰ page list: "N. first line", tinted on hover. A selected row's fill and edge are set on the
             row itself (PaintPageRow), so they win over the hover tint. -->
        <Style x:Key="PageRowStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="9,5">
                            <TextBlock Text="{TemplateBinding Content}" TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgSubtle}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="32,14">
            <TextBlock Text="{local:Tr ProjectWindow.Title}" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextMain}"/>
        </Border>

        <ScrollViewer Grid.Row="1" Background="{StaticResource BgMain}">
            <StackPanel Margin="32,24,32,28">
                <TextBlock Text="{local:Tr ProjectWindow.Name}" Style="{StaticResource SectionLabelStyle}"/>
                <TextBox x:Name="NameBox" Style="{StaticResource FieldStyle}" FontSize="15" FontWeight="SemiBold"
                         TextChanged="NameBox_TextChanged"/>
                <TextBlock x:Name="NameError" Text="{local:Tr ProjectWindow.NameRequired}" FontSize="12" Margin="2,6,0,0"
                           Foreground="{StaticResource Danger}" Visibility="Collapsed"/>

                <Border Style="{StaticResource SectionDividerStyle}"/>

                <!-- Files: documents and pictures attached to the project -->
                <TextBlock Text="{local:Tr ProjectWindow.Files}" Style="{StaticResource SectionLabelStyle}"/>
                <local:AttachmentsSection x:Name="Files"/>

                <Border Style="{StaticResource SectionDividerStyle}"/>

                <!-- Description: starts as the tallest field and grows with its text; the page scrolls, not the field -->
                <TextBlock Text="{local:Tr ProjectWindow.Description}" Style="{StaticResource SectionLabelStyle}"/>
                <Border x:Name="EditorFrame" MinHeight="240" Background="{StaticResource BgInput}"
                        BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <local:FormatToolbar x:Name="DescriptionToolbar"/>

                        <!-- The field people read most: as tall as its text (ProjectWindow.FollowCaret keeps the caret in
                             view). Language is fixed: WPF writes it into the stored text (xml:lang), which must not change
                             with the app's language. -->
                        <RichTextBox x:Name="DescriptionBox" Grid.Row="1" Language="en-US"
                                     VerticalScrollBarVisibility="Disabled"
                                     Background="Transparent" BorderThickness="0" Padding="10,10"
                                     Foreground="{StaticResource TextMain}" CaretBrush="{StaticResource TextMain}"
                                     FontFamily="Segoe UI" FontSize="14"
                                     AcceptsTab="False">
                            <RichTextBox.Resources>
                                <!-- No blank gap between paragraphs: Enter starts a plain new line -->
                                <Style TargetType="Paragraph">
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </RichTextBox.Resources>
                        </RichTextBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SectionDividerStyle}"/>

                <!-- Tasks: every row shown, the list as long as it gets; the page scrolls, not the list -->
                <TextBlock Text="{local:Tr ProjectWindow.Tasks}" Style="{StaticResource SectionLabelStyle}"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TaskInput" Style="{StaticResource FieldStyle}" Tag="{local:Tr ProjectWindow.TaskPlaceholder}"
                             AutomationProperties.Name="{local:Tr ProjectWindow.TaskPlaceholder}" KeyDown="TaskInput_KeyDown"/>
                    <Button Grid.Column="1" Content="{local:Tr ProjectWindow.AddTask}"
                            Height="40" Margin="8,0,0,0" Padding="16,0"
                            Click="AddTaskButton_Click"/>
                </Grid>

                <!-- Several tasks at once: Ctrl or Shift+click, Ctrl+A; Delete or a selected row's × deletes them -->
                <ListBox x:Name="TaskList" MinHeight="60" SelectionMode="Extended"
                         Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                         BorderThickness="1" Padding="0"
                         PreviewMouseLeftButtonDown="TaskList_PreviewMouseLeftButtonDown"
                         PreviewMouseRightButtonUp="TaskList_PreviewMouseRightButtonUp"
                         KeyDown="TaskList_KeyDown">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="4">
                                <Grid>
                                    <ItemsPresenter/>
                                    <TextBlock x:Name="emptyHint" Text="{local:Tr ProjectWindow.NoTasks}"
                                               FontSize="13" Foreground="{StaticResource TextSub}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextWrapping="Wrap" TextAlignment="Center" Margin="12"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter TargetName="emptyHint" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ListBox.Template>
                    <!-- Not virtualized: nothing scrolls inside the list, so every row is laid out (fast enough at hundreds) -->
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <!-- A clean list row: light tint on hover; accent tint and edge when selected (SelectionLook) -->
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,4,6,4"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="row" Background="Transparent" CornerRadius="6"
                                                BorderBrush="Transparent" BorderThickness="1"
                                                Padding="{TemplateBinding Padding}" MinHeight="34">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="row" Property="Background" Value="{StaticResource BgSubtle}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="row" Property="Background" Value="{StaticResource AccentSoft}"/>
                                                <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsDone}" FontSize="14" Click="TaskCheck_Click"
                                          VerticalAlignment="Center" VerticalContentAlignment="Center">
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                </CheckBox>
                                <!-- Shown while the row is hovered: the same Rename / Delete as its right-click menu -->
                                <Button x:Name="editButton" Grid.Column="1" Style="{StaticResource RowEditStyle}"
                                        Margin="6,0,2,0" Visibility="Hidden" Click="TaskRename_Click"/>
                                <Button x:Name="deleteButton" Grid.Column="2" Style="{StaticResource RowDeleteStyle}"
                                        Visibility="Hidden" Click="TaskDelete_Click"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="editButton" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="deleteButton" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{local:Tr ProjectWindow.TaskHint}" FontSize="12"
                           Foreground="{StaticResource TextSub}" Margin="2,8,0,0" TextWrapping="Wrap"/>

                <Border Style="{StaticResource SectionDividerStyle}"/>

                <!-- Notes: a notebook, one page at a time. Ctrl+PageUp / Ctrl+PageDown flip too. -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{local:Tr ProjectWindow.Notes}" Style="{StaticResource SectionLabelStyle}" Margin="0" VerticalAlignment="Center"/>
                    <Button x:Name="PrevPageButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                            Width="30" Height="30" Margin="16,0,0,0" ToolTip="{local:Tr ProjectWindow.PrevPage}" AutomationProperties.Name="{local:Tr ProjectWindow.PrevPage}"
                            Click="PrevPage_Click">
                        <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                    <TextBlock x:Name="PageIndicator" Grid.Column="2" MinWidth="56" TextAlignment="Center"
                               VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSub}"/>
                    <Button x:Name="NextPageButton" Grid.Column="3" Style="{StaticResource IconButtonStyle}"
                            Width="30" Height="30" ToolTip="{local:Tr ProjectWindow.NextPage}" AutomationProperties.Name="{local:Tr ProjectWindow.NextPage}"
                            Click="NextPage_Click">
                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                    <Button x:Name="DeletePageButton" Grid.Column="5" Style="{StaticResource IconButtonStyle}"
                            Width="30" Height="30" Click="DeletePage_Click">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                    </Button>
                    <Button x:Name="PageListButton" Grid.Column="6" Style="{StaticResource IconButtonStyle}"
                            Width="30" Height="30" Margin="6,0,0,0" ToolTip="{local:Tr ProjectWindow.AllPages}" AutomationProperties.Name="{local:Tr ProjectWindow.AllPages}" Click="PageList_Click">
                        <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                    </Button>
                    <Popup x:Name="PageListPopup" PlacementTarget="{Binding ElementName=PageListButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Closed="PageListPopup_Closed">
                        <!-- Ctrl/Shift+click and Ctrl+A select several pages (pageSelection); Delete or the bar deletes them -->
                        <Border x:Name="PageListPanel" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                                BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,4,6,6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12"/>
                            </Border.Effect>
                            <StackPanel>
                                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="PageListRows" Width="280"/>
                                </ScrollViewer>
                                <local:SelectionBar x:Name="PageSelectionBar" Visibility="Collapsed" HorizontalAlignment="Right" Margin="6,6,2,2"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- The current page, formatted like the description; a long page grows and the window scrolls.
                     Ruled lines: see NotebookRules (on the document, so they grow with the text). -->
                <Border x:Name="NotesFrame" Background="#FFFEFA" BorderBrush="#E4E2DD" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <local:FormatToolbar x:Name="NotesToolbar"/>

                        <!-- PageSheet slides in when a page is turned (ShowPage). Its own adorner layer keeps the
                             caret and selection moving with the text during the slide. -->
                        <Grid Grid.Row="1" Margin="18" MinHeight="384" ClipToBounds="True">
                            <AdornerDecorator x:Name="PageSheet">
                                <AdornerDecorator.RenderTransform>
                                    <TranslateTransform/>
                                </AdornerDecorator.RenderTransform>
                                <Grid>
                                    <!-- 5: the editor's built-in page padding, so the placeholder sits where typing starts -->
                                    <TextBlock x:Name="NotesPlaceholder" Text="{local:Tr ProjectWindow.NotesPlaceholder}" Margin="5,0,0,0" FontFamily="Segoe UI" FontSize="15"
                                               LineHeight="24" LineStackingStrategy="BlockLineHeight"
                                               Foreground="{StaticResource TextSub}" IsHitTestVisible="False"/>
                                    <RichTextBox x:Name="NotesBox" Language="en-US"
                                                 VerticalScrollBarVisibility="Disabled"
                                                 Background="Transparent" BorderThickness="0" Padding="0"
                                                 Foreground="{StaticResource TextMain}" CaretBrush="{StaticResource TextMain}"
                                                 FontFamily="Segoe UI" FontSize="15"
                                                 AcceptsTab="False">
                                        <RichTextBox.Resources>
                                            <!-- Every line exactly one rule tall, no gap between paragraphs -->
                                            <Style TargetType="Paragraph">
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="LineHeight" Value="24"/>
                                                <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
                                            </Style>
                                        </RichTextBox.Resources>
                                        <FlowDocument Background="{StaticResource NotebookRules}"/>
                                    </RichTextBox>
                                </Grid>
                            </AdornerDecorator>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Sticky footer: Save stays in reach however long the content gets -->
        <Border Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="32,12">
            <DockPanel>
                <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="{local:Tr Common.Save}"
                        MinWidth="128" Padding="16,0" Height="38"
                        FontWeight="SemiBold"
                        Click="SaveButton_Click"/>
                <Button x:Name="TransferButton" Content="{local:Tr Transfer.ExportMenu}" Style="{StaticResource GhostButtonStyle}"
                        Padding="14,0" Height="38" HorizontalAlignment="Left" Click="TransferButton_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
