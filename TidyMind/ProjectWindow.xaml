<Window x:Class="TidyMind.ProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TidyMind"
        mc:Ignorable="d"
        Title="Project Details" Height="620" Width="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMain}">
    <Window.Resources>
        <!-- Formatting toolbar toggles: highlighted while the selection already has that formatting.
             Not focusable, so clicking one never pulls focus (and the selection) out of the editor. -->
        <Style x:Key="FormatToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgSubtle}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentSoft}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#BFD6EC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="20,16">
            <TextBlock Text="Project Details" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextMain}"/>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="20,14" Background="{StaticResource BgMain}">
            <StackPanel>
                <TextBlock Text="Project Name" Foreground="{StaticResource TextSub}" FontSize="11" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Height="32" VerticalContentAlignment="Center"/>

                <TextBlock Text="Description" Foreground="{StaticResource TextSub}" FontSize="11" Margin="0,12,0,4"/>
                <Border x:Name="EditorFrame" Background="{StaticResource BgInput}"
                        BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <!-- Toolbar -->
                        <Border BorderBrush="#ECECE9" BorderThickness="0,0,0,1" Padding="6,4">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="BoldButton" Style="{StaticResource FormatToggleStyle}"
                                              ToolTip="Bold  (Ctrl+B)" Click="BoldButton_Click">
                                    <TextBlock Text="B" FontWeight="Bold"/>
                                </ToggleButton>
                                <ToggleButton x:Name="ItalicButton" Style="{StaticResource FormatToggleStyle}"
                                              ToolTip="Italic  (Ctrl+I)" Click="ItalicButton_Click">
                                    <TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia"/>
                                </ToggleButton>
                                <ToggleButton x:Name="UnderlineButton" Style="{StaticResource FormatToggleStyle}"
                                              ToolTip="Underline  (Ctrl+U)" Click="UnderlineButton_Click">
                                    <TextBlock Text="U" TextDecorations="Underline"/>
                                </ToggleButton>

                                <Rectangle Width="1" Height="18" Fill="#E0E0DE" Margin="6,0,8,0"/>

                                <ToggleButton x:Name="ColorButton" Style="{StaticResource FormatToggleStyle}"
                                              ToolTip="Text color" Click="ColorButton_Click">
                                    <Grid Width="16">
                                        <TextBlock Text="A" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                   Margin="0,-2,0,4"/>
                                        <Rectangle x:Name="ColorBar" Height="3" RadiusX="1" RadiusY="1"
                                                   VerticalAlignment="Bottom" Fill="{StaticResource TextMain}"/>
                                    </Grid>
                                </ToggleButton>
                                <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ColorButton}"
                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                       Closed="ColorPopup_Closed">
                                    <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                                            BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,4,6,6">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12"/>
                                        </Border.Effect>
                                        <StackPanel x:Name="ColorSwatches" Orientation="Horizontal"/>
                                    </Border>
                                </Popup>
                            </StackPanel>
                        </Border>

                        <!-- Grows with its content from ~4 lines up to ~11, then scrolls -->
                        <RichTextBox x:Name="DescriptionBox"
                                     MinHeight="86" MaxHeight="214"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="Transparent" BorderThickness="0" Padding="6,6"
                                     Foreground="{StaticResource TextMain}" CaretBrush="{StaticResource TextMain}"
                                     FontFamily="Segoe UI" FontSize="13"
                                     AcceptsTab="False"
                                     SelectionChanged="DescriptionBox_SelectionChanged">
                            <RichTextBox.Resources>
                                <!-- No blank gap between paragraphs: Enter starts a plain new line -->
                                <Style TargetType="Paragraph">
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </RichTextBox.Resources>
                        </RichTextBox>
                    </StackPanel>
                </Border>

                <TextBlock Text="Status" Foreground="{StaticResource TextSub}" FontSize="11" Margin="0,12,0,4"/>
                <ComboBox x:Name="StatusBox" Height="32"
                          ItemsSource="{Binding Source={x:Static local:ProjectStatusItems.All}}"/>

                <TextBlock Text="Tasks" Foreground="{StaticResource TextSub}" FontSize="11" Margin="0,12,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox x:Name="TaskInput" Width="270" Height="32"
                             VerticalContentAlignment="Center"
                             KeyDown="TaskInput_KeyDown"/>
                    <Button x:Name="AddTaskButton" Content="Add Task"
                            Height="32" Margin="10,0,0,0" Padding="12,0"
                            Click="AddTaskButton_Click"/>
                    <TextBlock Text="Right-click to edit"
                               FontSize="11" Foreground="{StaticResource TextSub}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <ListBox x:Name="TaskList" MinHeight="80"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         PreviewMouseWheel="TaskList_PreviewMouseWheel"
                         PreviewMouseRightButtonUp="TaskList_PreviewMouseRightButtonUp"
                         KeyDown="TaskList_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Title}" IsChecked="{Binding IsDone}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="Notes" Foreground="{StaticResource TextSub}" FontSize="11" Margin="0,12,0,4"/>
                <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                    <TextBox x:Name="NoteText" Text="No notes" Style="{StaticResource SelectableTextStyle}"
                             FontSize="13" Foreground="{StaticResource TextSub}" MinHeight="50"/>
                </Border>
                <Button x:Name="NoteButton" Content="Add Note"
                        Style="{StaticResource GhostButtonStyle}"
                        Width="110" Height="30" HorizontalAlignment="Left"
                        Click="NoteButton_Click"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="20,10">
            <Button x:Name="SaveButton" Content="Save"
                    Width="120" Height="34" HorizontalAlignment="Right"
                    FontWeight="Bold"
                    Click="SaveButton_Click"/>
        </Border>
    </Grid>
</Window>
