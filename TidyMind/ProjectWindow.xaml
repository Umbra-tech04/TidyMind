<Window x:Class="TidyMind.ProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TidyMind"
        mc:Ignorable="d"
        Title="Project Details" Height="600" Width="500">
    <Grid>
        <ScrollViewer>
            <StackPanel Margin="20">
                <Label Content="Project Name:"/>
                <TextBox x:Name="NameBox" Height="30" FontSize="14"/>

                <Label Content="Description:" Margin="0,10,0,0"/>
                <TextBox x:Name="DescriptionBox" Height="80" FontSize="14"
         TextWrapping="Wrap" AcceptsReturn="True"
         VerticalScrollBarVisibility="Auto"/>

                <Label Content="Status:" Margin="0,10,0,0"/>
                <TextBox x:Name="StatusBox" Height="30" FontSize="14"/>

                <Label Content="Tasks:" Margin="0,10,0,0"/>

                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="TaskInput" Width="250" Height="30" FontSize="14"/>
                    <Button x:Name="AddTaskButton" Content="Add Task"
                            Height="30" Margin="10,0,0,0" Click="AddTaskButton_Click"/>
                </StackPanel>

                <ListBox x:Name="TaskList" Height="120" Margin="0,10,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Title}" IsChecked="{Binding IsDone}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button x:Name="DeleteTaskButton" Content="Delete Task"
        Height="30" Margin="0,10,0,0" Click="DeleteTaskButton_Click"/>

                <Label Content="Note:" Margin="0,10,0,0"/>

                <TextBlock x:Name="NoteText" Text="No notes"
                           FontSize="14" Foreground="Gray"
                           TextWrapping="Wrap" MinHeight="60"
                           Margin="0,0,0,10"/>

                <Button x:Name="NoteButton" Content="Add Note"
                        Width="100" Height="24" HorizontalAlignment="Left"
                        Click="NoteButton_Click"/>

                <Button x:Name="SaveButton" Content="Save"
                        Width="120" Height="35" HorizontalAlignment="Left"
                        Margin="0,20,0,0"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>