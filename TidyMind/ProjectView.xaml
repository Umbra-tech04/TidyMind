<UserControl x:Class="TidyMind.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:TidyMind"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <!-- Right-click on empty space opens Edit Background (MemoryPageBackground). -->
    <Grid x:Name="Page" Background="{StaticResource BgMain}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The memory's own background (Edit Background), behind everything -->
        <Grid x:Name="BackgroundLayer" Grid.RowSpan="4" IsHitTestVisible="False" ClipToBounds="True"/>

        <!-- On a background picture: a light plate behind the header and tabs, so their text reads on any photo
             (MemoryPageBackground shows it). Its own element, so the shadow doesn't fall on the text. -->
        <Border x:Name="HeaderPlate" Grid.RowSpan="3" Margin="14,12,14,0" CornerRadius="14" Background="{StaticResource BgPlate}"
                IsHitTestVisible="False" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.16" Color="#000000"/>
            </Border.Effect>
        </Border>

        <!-- Header -->
        <Border Grid.Row="0" Padding="28,24,28,16">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource PlateText}"/>
                    <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="{DynamicResource PlateTextSub}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- While cards are selected, the selection bar replaces this row (see UpdateSelectionBar) -->
                <local:SelectionBar x:Name="SelectionBar" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Visibility="Collapsed"/>
                <StackPanel x:Name="Toolbar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}"
                             Width="240" Margin="0,0,10,0"
                             Tag="{local:Tr Common.SearchPlaceholder}"
                             AutomationProperties.Name="{local:Tr Common.SearchPlaceholder}"
                             TextChanged="SearchBox_TextChanged"/>
                    <Button Height="36" Padding="16,0" Click="AddProjectButton_Click">
                        <TextBlock><Run Text="+  "/><Run Text="{local:Tr Project.Add}"/></TextBlock>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Inline to-do list for this memory, and beside it the memory's notebook -->
        <Grid Grid.Row="1" Margin="28,0,28,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <local:MemoryTodoPanel x:Name="TodoPanel"/>
            <local:NotebookButton x:Name="NotebookButton" Grid.Column="1" Height="32" Margin="10,0,0,0" VerticalAlignment="Top"/>
        </Grid>

        <!-- Tab strip -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      Padding="26,0,28,6">
            <StackPanel x:Name="TabStrip" Orientation="Horizontal"/>
        </ScrollViewer>

        <!-- Cards -->
        <!-- Drag on empty space to select cards (CardSelectionController) -->
        <ScrollViewer x:Name="CardScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" FocusVisualStyle="{x:Null}" Padding="16,0,16,24">
            <Grid x:Name="CardArea">
                <WrapPanel x:Name="ProjectPanel"/>
                <!-- Nothing in this tab, nothing found, or the file can't be read: a small card, shown with its text -->
                <Border x:Name="EmptyCard" Style="{StaticResource EmptyCardStyle}" Visibility="{Binding Visibility, ElementName=EmptyState}">
                    <StackPanel>
                        <TextBlock Text="&#xE821;" Style="{StaticResource EmptyCardIconStyle}"/>
                        <TextBlock x:Name="EmptyState" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource PlateBody}" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
                <Canvas x:Name="MarqueeCanvas" IsHitTestVisible="False"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
