<Window x:Class="TidyMind.LicensesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Licenses" Width="440" SizeToContent="Height" MaxHeight="420"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgMain}">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- THIRD-PARTY-NOTICES.txt, the same text that ships next to the exe; selectable, scrolls when long -->
        <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12">
                <TextBox x:Name="NoticesText" Style="{StaticResource SelectableTextStyle}" FontSize="12" IsTabStop="True"
                         Foreground="{StaticResource TextBody}"/>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="1" Content="Close" IsCancel="True" Style="{StaticResource GhostButtonStyle}"
                HorizontalAlignment="Right" Width="92" Height="36" Margin="0,16,0,0"/>
    </Grid>
</Window>
