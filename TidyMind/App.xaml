<Application x:Class="TidyMind.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TidyMind">
    <Application.Resources>

        <!-- ===== Palette (light editorial + dark sidebar) ===== -->
        <SolidColorBrush x:Key="BgMain"       Color="#F5F5F3"/>
        <SolidColorBrush x:Key="BgPanel"      Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgInput"      Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgSubtle"     Color="#F0F0EE"/>
        <SolidColorBrush x:Key="TextMain"     Color="#1C1B19"/>
        <SolidColorBrush x:Key="TextSub"      Color="#8A8A87"/>
        <SolidColorBrush x:Key="TextBody"     Color="#3A3936"/> <!-- secondary reading text: softer than TextMain, darker than TextSub -->
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily> <!-- large or title type -->

        <SolidColorBrush x:Key="Accent"       Color="#2E7BC4"/>
        <SolidColorBrush x:Key="AccentSoft"   Color="#EAF2F9"/>
        <SolidColorBrush x:Key="BtnBg"        Color="#2E7BC4"/>
        <SolidColorBrush x:Key="BtnHover"     Color="#25639D"/>
        <SolidColorBrush x:Key="Border"       Color="#E0E0DE"/>
        <SolidColorBrush x:Key="Danger"       Color="#C0392B"/>

        <!-- Sidebar -->
        <SolidColorBrush x:Key="Sidebar"      Color="#1C1B19"/>
        <SolidColorBrush x:Key="SidebarText"  Color="#E8E8E6"/>
        <SolidColorBrush x:Key="SidebarSub"   Color="#8F8F8B"/>
        <SolidColorBrush x:Key="SidebarHover" Color="#2A2926"/>

        <!-- ===== Window ===== -->
        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource BgMain}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="13"/>
        </Style>

        <!-- ===== TextBlock ===== -->
        <!-- No Foreground here: this style also hits the text inside buttons/tooltips and would override their color. -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- ===== Label ===== -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding"    Value="0,8,0,2"/>
        </Style>

        <!-- ===== TextBox ===== -->
        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="CaretBrush"      Value="{StaticResource TextMain}"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
        </Style>

        <!-- ===== Search box (single-line, with magnifier) ===== -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height"      Value="36"/>
            <Setter Property="Background"  Value="#FAFAF9"/>
            <Setter Property="BorderBrush" Value="#D5D5D2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="icon" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{StaticResource TextSub}"
                                           VerticalAlignment="Center" Margin="11,0,8,0"
                                           IsHitTestVisible="False"/>
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1"
                                              VerticalAlignment="Center" Margin="0,0,10,0"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#BDBDB9"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="icon" Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Selectable read-only text (looks like a TextBlock, can be selected and copied) ===== -->
        <!-- Its own menu: the stock TextBox one greys out Copy until something is selected. -->
        <ContextMenu x:Key="SelectableTextMenu" x:Shared="False">
            <MenuItem Header="Copy" Click="SelectableTextCopy_Click"/>
        </ContextMenu>
        <Style x:Key="SelectableTextStyle" TargetType="TextBox">
            <Setter Property="ContextMenu"     Value="{StaticResource SelectableTextMenu}"/>
            <Setter Property="IsReadOnly"      Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="TextWrapping"    Value="Wrap"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="IsTabStop"       Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <!-- -2: the text view's built-in inset, so the text lines up with plain TextBlocks -->
                        <ScrollViewer x:Name="PART_ContentHost" Margin="-2,0" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Inline rename box (pill-shaped, e.g. tab names) ===== -->
        <Style x:Key="InlineEditBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Padding"    Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Accent}" BorderThickness="1.5"
                                CornerRadius="15" Padding="12,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Button (primary, accent) ===== -->
        <Style TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource BtnBg}"/>
            <Setter Property="Foreground"      Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource BtnHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource BtnHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Ghost / secondary button (light, bordered) ===== -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource BgPanel}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextMain}"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource BgSubtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Text link button (e.g. "Show done", a reminder row's Edit / Delete) ===== -->
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="2,2">
                            <TextBlock x:Name="label" Text="{TemplateBinding Content}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="label" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Hover icon button: the small icon-only button that appears on a row for edit / delete / … =====
             Content is one Segoe MDL2 Assets glyph, written as an escaped code point (&#xE70F;), never a pasted
             character. The glyph is drawn by an explicit TextBlock that takes the button's own FontFamily: the global
             TextBlock style above forces Segoe UI onto the TextBlock a ContentPresenter generates, which turned
             every icon into an empty "missing glyph" square. Row styles below only set the glyph and tooltip. -->
        <SolidColorBrush x:Key="AccentTint"   Color="#1F2E7BC4"/> <!-- Accent at 12%: hover background -->
        <SolidColorBrush x:Key="AccentTintStrong" Color="#382E7BC4"/> <!-- Accent at 22%: pressed -->
        <Style x:Key="HoverIconButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                    <Setter Property="Background" Value="{StaticResource AccentTint}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentTintStrong}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- "×" on a checklist row (to-dos, to-do lists, project tasks): the glyph turns red on hover -->
        <Style x:Key="RowDeleteStyle" TargetType="Button" BasedOn="{StaticResource HoverIconButtonStyle}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Content" Value="&#xE711;"/>
            <Setter Property="ToolTip" Value="Delete"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Pencil on a checklist row: rename / edit -->
        <Style x:Key="RowEditStyle" TargetType="Button" BasedOn="{StaticResource HoverIconButtonStyle}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Content" Value="&#xE70F;"/>
            <Setter Property="ToolTip" Value="Rename"/>
        </Style>

        <!-- ===== Square icon button ===== -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource BgPanel}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextMain}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource AccentSoft}"/>
                                <Setter TargetName="border" Property="BorderBrush"
                                        Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ListBox ===== -->
        <Style TargetType="ListBox">
            <Setter Property="Background"      Value="{StaticResource BgPanel}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="4"/>
        </Style>

        <!-- ===== ListBoxItem ===== -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding"    Value="8,6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgSubtle}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== ComboBox ===== -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"      Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                                <Grid>
                                    <ContentPresenter
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Margin="8,6,30,6"
                                VerticalAlignment="Center"/>
                                    <TextBlock Text="▾"
                                       Foreground="{StaticResource TextSub}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Slide">
                                <Border Background="{StaticResource BgPanel}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                MinWidth="{Binding ActualWidth, ElementName=border}">
                                    <ScrollViewer MaxHeight="200" Background="{StaticResource BgPanel}">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            <ToggleButton
                        Focusable="False"
                        IsChecked="{Binding Path=IsDropDownOpen,
                            RelativeSource={RelativeSource TemplatedParent},
                            Mode=TwoWay}"
                        Background="Transparent"
                        BorderThickness="0"
                        Opacity="0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ComboBoxItem ===== -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Padding"    Value="8,6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== CheckBox ===== -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding"    Value="4,2"/>
        </Style>

        <!-- ===== ScrollViewer ===== -->
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ===== ContextMenu ===== -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background"  Value="{StaticResource BgPanel}"/>
            <Setter Property="Foreground"  Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>

        <!-- ===== MenuItem ===== -->
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>

        <!-- ===== ToolTip ===== -->
        <Style TargetType="ToolTip">
            <Setter Property="Background"  Value="{StaticResource TextMain}"/>
            <Setter Property="Foreground"  Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>

    </Application.Resources>
</Application>
