<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 version brings in the Windows API for reminder notifications (ReminderManager). Runs from
         1607 on, like the installer's MinVersion; the analyzer flags any call that needs a newer Windows. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.14393.0</SupportedOSPlatformVersion>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
	<ApplicationIcon>fej.ico</ApplicationIcon>
    <!-- The one version number: the About line, the update check, build-installer.ps1 and the installer file name
         (TidyMind-Setup-<version>.exe) all read it. Raise it before every release (installer\publish-release.ps1). -->
    <Version>1.1.0</Version>
  </PropertyGroup>

  <!-- UseWindowsForms adds a project-wide implicit "using System.Windows.Forms;"
       which collides with WPF types (TextBox, ComboBox, Button, Application, KeyEventArgs, ...).
       We only need System.Windows.Forms explicitly in ReminderManager.cs, so drop the global one. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <!-- The licence list: shipped next to the exe, and built in for Settings > Licenses. -->
  <ItemGroup>
    <None Update="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="THIRD-PARTY-NOTICES.txt" LogicalName="TidyMind.THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="QuestPDF" Version="2026.9.0" />
    <PackageReference Include="TaskScheduler" Version="2.12.2" />
  </ItemGroup>

</Project>
