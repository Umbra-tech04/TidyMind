<UserControl x:Class="TidyMind.FormatToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Formatting toggles: tinted on hover, filled while the formatting is applied at the caret.
             Not focusable, so clicking one never pulls focus (and the selection) out of the editor. -->
        <Style x:Key="FormatToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A2E7BC4"/> <!-- accent, 10% -->
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#332E7BC4"/> <!-- accent, 20% -->
                                <Setter TargetName="border" Property="BorderBrush" Value="#802E7BC4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="#FAFAF9" BorderBrush="#E4E2DD" BorderThickness="0,0,0,1"
            CornerRadius="8,8,0,0" Padding="8,6">
        <StackPanel Orientation="Horizontal">
            <ToggleButton x:Name="BoldButton" Style="{StaticResource FormatToggleStyle}"
                          ToolTip="Bold  (Ctrl+B)" Click="BoldButton_Click">
                <TextBlock Text="B" FontWeight="Bold"/>
            </ToggleButton>
            <ToggleButton x:Name="ItalicButton" Style="{StaticResource FormatToggleStyle}"
                          ToolTip="Italic  (Ctrl+I)" Click="ItalicButton_Click">
                <TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia"/>
            </ToggleButton>
            <ToggleButton x:Name="UnderlineButton" Style="{StaticResource FormatToggleStyle}"
                          ToolTip="Underline  (Ctrl+U)" Click="UnderlineButton_Click">
                <TextBlock Text="U" TextDecorations="Underline"/>
            </ToggleButton>

            <Rectangle Width="1" Height="20" Fill="#E4E2DD" Margin="6,0,10,0"/>

            <!-- Text color: a swatch of the color at the caret, with a caret to show it opens -->
            <ToggleButton x:Name="ColorButton" Style="{StaticResource FormatToggleStyle}" Width="48"
                          ToolTip="Text color" Click="ColorButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ColorBar" Width="16" Height="16" Fill="{StaticResource TextMain}"
                             Stroke="#33000000" StrokeThickness="1"/>
                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                               Foreground="{StaticResource TextSub}" VerticalAlignment="Center"
                               Margin="6,1,0,0"/>
                </StackPanel>
            </ToggleButton>
            <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ColorButton}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                   Closed="ColorPopup_Closed">
                <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,4,6,6">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12"/>
                    </Border.Effect>
                    <StackPanel x:Name="ColorSwatches" Orientation="Horizontal"/>
                </Border>
            </Popup>
        </StackPanel>
    </Border>
</UserControl>
