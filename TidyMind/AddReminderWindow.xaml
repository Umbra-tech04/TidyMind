<Window x:Class="TidyMind.AddReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TidyMind"
        mc:Ignorable="d"
        Title="Add Reminder" Height="560" Width="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMain}">
    <Window.Resources>
        <!-- Light-themed DatePicker text box -->
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Border Background="{StaticResource BgInput}" BorderBrush="{StaticResource Border}"
                                BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <TextBox x:Name="PART_TextBox"
                                         Background="Transparent"
                                         Foreground="{StaticResource TextMain}"
                                         CaretBrush="{StaticResource TextMain}"
                                         BorderThickness="0"
                                         Padding="8,4"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding Path=SelectedDate, RelativeSource={RelativeSource AncestorType=DatePicker}, StringFormat='yyyy-MM-dd', Mode=OneWay}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Height" Value="32"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="20,16">
            <TextBlock x:Name="HeadingText" Text="Add Reminder" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextMain}"/>
        </Border>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="20,16">
            <TextBlock x:Name="SubtitleText"
                       FontSize="12" Foreground="{StaticResource TextSub}"
                       TextWrapping="Wrap" Margin="0,0,0,16"/>

            <TextBlock Text="Message" Foreground="{StaticResource TextSub}" FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="MessageInput" Height="80"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,16"
                     GotFocus="MessageInput_GotFocus"
                     LostFocus="MessageInput_LostFocus"/>

            <TextBlock Text="Date" Foreground="{StaticResource TextSub}" FontSize="11" Margin="0,0,0,4"/>
            <DatePicker x:Name="ReminderDatePicker" Margin="0,0,0,16"/>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Hour" Foreground="{StaticResource TextSub}" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="HourBox" Height="32"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Minute" Foreground="{StaticResource TextSub}" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="MinuteBox" Height="32"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Repeat" Foreground="{StaticResource TextSub}" FontSize="11" Margin="0,0,0,4"/>
            <!-- Items come from ReminderForm.FillRepeatBox -->
            <ComboBox x:Name="RepeatBox" Height="32"/>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="20,10">
            <Button x:Name="SaveButton" Content="Save Reminder"
                    Width="150" Height="34" HorizontalAlignment="Right"
                    FontWeight="Bold"
                    Click="SaveButton_Click"/>
        </Border>
    </Grid>
</Window>
