<UserControl x:Class="TidyMind.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:TidyMind"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <!-- Home reads like the opening spread of a daybook, not an admin panel. The to-do list is the white sheet you
         write on, and the week is printed straight onto the page. Numbers appear inside sentences, never as stat
         tiles. The feature tiles at the bottom are framed notes to read, nothing to click. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="Hairline" Color="#E4E4E1"/>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>
        <!-- The sentence that sits beside a section title and says what's in it -->
        <Style x:Key="SectionLedeStyle" TargetType="TextBox" BasedOn="{StaticResource SelectableTextStyle}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="Margin" Value="12,0,0,1"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{StaticResource BgMain}" VerticalScrollBarVisibility="Auto">
        <!-- Bottom margin clears the floating corner buttons -->
        <StackPanel x:Name="Page" Margin="48,40,48,88" MaxWidth="1040">

            <!-- Masthead: date and greeting -->
            <TextBox x:Name="DateText" Style="{StaticResource SelectableTextStyle}"
                     FontSize="13" Foreground="{StaticResource TextSub}"/>
            <TextBox x:Name="GreetingText" Style="{StaticResource SelectableTextStyle}"
                     FontFamily="{StaticResource DisplayFont}" FontSize="40" FontWeight="Light"
                     Foreground="{StaticResource TextMain}" Margin="0,2,0,0"/>

            <!-- The day: to-do sheet beside the week. Stacks on narrow windows (see ApplyWidth). -->
            <Grid x:Name="DayGrid" Margin="0,40,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="TodoSheet" Background="{StaticResource BgPanel}" CornerRadius="16"
                        Padding="24,20,24,18">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="12" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{local:Tr Home.Todo.Title}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,14"/>
                        <local:QuickTodoListControl x:Name="QuickTodos"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="WeekPanel" Grid.Column="2">
                    <!-- Today's plan: what's still ahead today (DayPlanStore); the link opens the day plan -->
                    <DockPanel Margin="0,20,0,4" LastChildFill="False">
                        <TextBlock Text="{local:Tr Home.Plan.Title}" Style="{StaticResource SectionTitleStyle}"/>
                        <Button x:Name="OpenPlanLink" DockPanel.Dock="Right" Style="{StaticResource LinkButtonStyle}"
                                Foreground="{StaticResource TextSub}" VerticalAlignment="Bottom" Click="OpenPlan_Click"/>
                    </DockPanel>
                    <StackPanel x:Name="PlanRows"/>

                    <TextBlock Text="{local:Tr Home.Week.Title}" Style="{StaticResource SectionTitleStyle}" Margin="0,28,0,6"/>
                    <StackPanel x:Name="Daybook"/>
                </StackPanel>
            </Grid>

            <!-- Getting started (GettingStarted): four first things, ticked from the user's own data. Hide puts it away,
                 ? > Getting started brings it back; it goes once all four are done. Below the day, so Home's top stays put. -->
            <StackPanel x:Name="ChecklistSection" Margin="0,52,0,0" Visibility="Collapsed">
                <DockPanel Margin="0,0,0,12" LastChildFill="False">
                    <TextBlock Text="{local:Tr Checklist.Title}" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBox x:Name="ChecklistLede" Style="{StaticResource SectionLedeStyle}"/>
                    <Button x:Name="ChecklistHide" DockPanel.Dock="Right" Style="{StaticResource LinkButtonStyle}"
                            Foreground="{StaticResource TextSub}" VerticalAlignment="Bottom"
                            Content="{local:Tr Home.Discovery.Hide}" Click="ChecklistHide_Click"/>
                </DockPanel>
                <Border Background="{StaticResource BgPanel}" CornerRadius="16" Padding="24,8,24,8">
                    <StackPanel x:Name="ChecklistRows"/>
                </Border>
            </StackPanel>

            <!-- What can TidyMind do?: tiles to read (HomeView.Features); Hide/Show folds them (AppSettings.HideDiscovery) -->
            <StackPanel Margin="0,52,0,0">
                <DockPanel Margin="0,0,0,12" LastChildFill="False">
                    <TextBlock Text="{local:Tr Home.Discovery.Title}" Style="{StaticResource SectionTitleStyle}"/>
                    <Button x:Name="DiscoveryToggle" DockPanel.Dock="Right" Style="{StaticResource LinkButtonStyle}"
                            Foreground="{StaticResource TextSub}" VerticalAlignment="Bottom" Click="DiscoveryToggle_Click"/>
                </DockPanel>
                <!-- Columns follow the width (ApplyWidth) -->
                <UniformGrid x:Name="DiscoveryItems" Columns="4"/>
            </StackPanel>

            <!-- Upcoming expiries: dates from collections (insurance, inspection) within 60 days or already past,
                 soonest first. Shown only when there are any. -->
            <StackPanel x:Name="ExpirySection" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Margin="0,52,0,12">
                    <TextBlock Text="{local:Tr Home.Expiries.Title}" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBox x:Name="ExpiriesLede" Style="{StaticResource SectionLedeStyle}"/>
                </StackPanel>
                <!-- Up to 560 wide, left-aligned, so the times line up in one column -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="560"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="ExpiryRows"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
