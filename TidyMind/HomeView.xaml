<UserControl x:Class="TidyMind.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:TidyMind"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <!-- Home reads like the opening spread of a daybook, not an admin panel. The to-do list is the one white sheet
         you write on, and the week is printed straight onto the page. Numbers appear inside sentences, never as
         stat tiles. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="Hairline" Color="#E4E4E1"/>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>
        <!-- The sentence that sits beside a section title and says what's in it -->
        <Style x:Key="SectionLedeStyle" TargetType="TextBox" BasedOn="{StaticResource SelectableTextStyle}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="Margin" Value="12,0,0,1"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        <!-- A "What can TidyMind do?" item: a row printed on the page that turns into paper under the cursor, like
             the week's entries; the keyboard focus shows as an accent edge -->
        <Style x:Key="DiscoveryItemStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="8" Padding="10,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{StaticResource BgPanel}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{StaticResource BgMain}" VerticalScrollBarVisibility="Auto">
        <!-- Bottom margin clears the floating corner buttons -->
        <StackPanel x:Name="Page" Margin="48,40,48,88" MaxWidth="1040">

            <!-- Masthead: date and greeting -->
            <TextBox x:Name="DateText" Style="{StaticResource SelectableTextStyle}"
                     FontSize="13" Foreground="{StaticResource TextSub}"/>
            <TextBox x:Name="GreetingText" Style="{StaticResource SelectableTextStyle}"
                     FontFamily="{StaticResource DisplayFont}" FontSize="40" FontWeight="Light"
                     Foreground="{StaticResource TextMain}" Margin="0,2,0,0"/>

            <!-- The day: to-do sheet beside the week. Stacks on narrow windows (see ApplyWidth). -->
            <Grid x:Name="DayGrid" Margin="0,40,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="TodoSheet" Background="{StaticResource BgPanel}" CornerRadius="16"
                        Padding="24,20,24,18">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="12" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="To-do" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,14"/>
                        <local:QuickTodoListControl x:Name="QuickTodos"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="WeekPanel" Grid.Column="2">
                    <TextBlock Text="This week" Style="{StaticResource SectionTitleStyle}" Margin="0,20,0,6"/>
                    <StackPanel x:Name="Daybook"/>
                </StackPanel>
            </Grid>

            <!-- What can TidyMind do?: printed on the page like the week. Each item starts the guided tour at its step
                 (Backup opens Settings). Filled from TourSteps.Discovery; Hide removes the row for good (AppSettings). -->
            <StackPanel x:Name="DiscoverySection" Margin="0,52,0,0">
                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock x:Name="DiscoveryTitle" Style="{StaticResource SectionTitleStyle}"/>
                    <Button x:Name="HideDiscoveryLink" DockPanel.Dock="Right" Style="{StaticResource LinkButtonStyle}"
                            Foreground="{StaticResource TextSub}" VerticalAlignment="Bottom" Click="HideDiscovery_Click"/>
                </DockPanel>
                <UniformGrid x:Name="DiscoveryItems" Columns="6" Margin="-10,0,-10,0"/>
            </StackPanel>

            <!-- Upcoming expiries: dates from collections (insurance, inspection) within 60 days or already past,
                 soonest first. Shown only when there are any. -->
            <StackPanel x:Name="ExpirySection" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Margin="0,52,0,12">
                    <TextBlock Text="Upcoming expiries" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBox x:Name="ExpiriesLede" Style="{StaticResource SectionLedeStyle}"/>
                </StackPanel>
                <!-- Up to 560 wide, left-aligned, so the times line up in one column -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="560"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="ExpiryRows"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
